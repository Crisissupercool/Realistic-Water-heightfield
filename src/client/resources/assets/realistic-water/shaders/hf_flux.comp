#version 450
// Pass 1 of the virtual-pipe step: outflow from each span through each of its links. Bodies moving through the water
// (hfStir) drag it along: the flow through a link facing their motion is pulled toward their speed times the wetted face, so
// water piles up in front of them (bow wave) and drains in behind (wake) while the volume stays exact.
#include "hf_common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 2) readonly buffer Depth { float depth[]; };
layout(std430, binding = 3) buffer Flux { float flux[]; };

#define HF_DT hp.p0.x
#define HF_G hp.p0.y
#define HF_CELL hp.p0.z
#define HF_KEEP hp.p0.w
// The first HF_MIN_FLOW of water in a span stays put as a film: it does not push sideways, so floods stop spreading over open
// ground once their edge is this thin. It still drains over an edge into a neighbor whose water surface lies below its floor
// (holes, steps, slopes). Only the water above the film drives sideways flow, so the flow fades out smoothly as a span thins
// to the film (a hard cut-off at the film depth made thin water advance in pulses: fill to 1 cm, flow, stop, refill, which
// showed as films popping in and out); the flow it still carries fades with it.
#define HF_MIN_FLOW hp.p1.z
// How fast (1/s) a body drags the water around it up to its own speed. A drag, not a hard push: the water can still flow back,
// so a fast body makes a wave rather than shoving a wall of water ahead of it.
const float HF_STIR_RATE = 8.0;

void main() {
    HfSpan a;
    if (!hfFromList(GID_U, a)) {
        return;
    }
    uint base = a.flux;
    vec2 ga = hfGeo(a.span);
    float hA = depth[a.span];
    if (!hfValid(ga) || hA <= 0.0) {
        for (uint k = 0u; k < HF_LINKS; k++) {
            flux[base + k] = 0.0;
        }
        return;
    }
    float headA = ga.x + hA;
    float filmCarry = clamp(hA / HF_MIN_FLOW, 0.0, 1.0);
    vec3 stir = hfStir(a, ga.x, min(headA, ga.y));
    float drag = 1.0 - exp(-HF_STIR_RATE * HF_DT);
    float outflow[8];
    float total = 0.0;
    for (uint k = 0u; k < HF_LINKS; k++) {
        outflow[k] = 0.0;
        uint nib = hfLink(a, k);
        HfSpan b;
        if (nib == HF_LINK_NONE || !hfNeighbor(a, k, nib, true, b)) {
            continue;
        }
        vec2 gb = hfGeo(b.span);
        float hB = depth[b.span];
        float headB = gb.x + hB;
        // Only water inside the shared opening can move.
        float lo = max(ga.x, gb.x);
        float hi = min(ga.y, gb.y);
        float wetA = clamp(headA, lo, hi) - lo;
        if (wetA <= 0.0) {
            continue;
        }
        float wetB = clamp(headB, lo, hi) - lo;
        float area = HF_CELL * max(wetA, wetB);
        // Water pouring over an edge onto lower water (a free overfall, like a weir) is driven only by the water above the
        // edge, not by how far it then falls: the full drop as head pulled the edge cell empty every step, so the water at
        // the brink was a near-dry film and the stream's surface ended before the waterfall began.
        float drive = headA - max(headB, ga.x);
        float carry = 1.0;
        if (headB >= ga.x) {
            // Sideways: the film on either side does not count.
            drive = ga.x + max(hA - HF_MIN_FLOW, 0.0) - max(gb.x + max(hB - HF_MIN_FLOW, 0.0), ga.x);
            carry = filmCarry;
        }
        float q = flux[base + k] * HF_KEEP * carry + HF_DT * HF_G * area * drive / HF_CELL;
        if (stir.z > 0.0) {
            uint d = k >> 1;
            float target = dot(stir.xy, vec2(HF_DX[d], HF_DZ[d])) * HF_CELL * min(stir.z, wetA);
            q += drag * max(target - q, 0.0);
        }
        outflow[k] = max(q, 0.0);
        total += outflow[k];
    }
    // Never send out more water than the span holds.
    float volume = hA * HF_CELL * HF_CELL;
    float scale = total * HF_DT > volume ? volume / (total * HF_DT) : 1.0;
    for (uint k = 0u; k < HF_LINKS; k++) {
        flux[base + k] = outflow[k] * scale;
    }
}
