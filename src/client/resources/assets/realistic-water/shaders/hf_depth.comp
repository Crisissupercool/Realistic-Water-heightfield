#version 450
// Pass 2 of the virtual-pipe step: apply in- and outflow to each span's depth, and reduce per-group stats
// (volume, max depth, max speed, max surface rate, border-growth bits) for mass checks, the CFL step, sleeping and tile growth.
// Also carries the foam along with the water and adds new foam where water falls in, runs fast or is stirred by a body.
#include "hf_common.glsl"
#include "hf_spray.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 2) buffer Depth { float depth[]; };
layout(std430, binding = 3) readonly buffer Flux { float flux[]; };
// Two vec4 per (span page, group of 256 spans): (volume, max depth, max speed, max rate), (border bits as uint, 0, 0, 0).
layout(std430, binding = 8) writeonly buffer Stats { vec4 stats[]; };

#define HF_DT hp.p0.x
#define HF_CELL hp.p0.z
#define HF_MAX_SPEED hp.p1.x
// Same as HF_MIN_FLOW in hf_flux.comp: only water that can still flow out asks for a new tile.
#define HF_GROW_DEPTH hp.p1.z
// Foam left after one step (exp(-dt / life)), and which half of the foam buffer this step reads and writes.
#define HF_FOAM_KEEP hp.p1.w
#define HF_FOAM_READ uint(hp.p2.x)
#define HF_FOAM_WRITE uint(hp.p2.y)
// Water falling into a span, weighted by how far it falls (blocks of depth per second x blocks, up to 4), that makes it fully
// white: a trickle down a 1-block step barely foams, a waterfall does. Flow speeds (blocks/s) over which
// fast water turns white; body speeds over which a body stirs up foam.
const float FOAM_FALL_RATE = 6.0;
const vec2 FOAM_FAST = vec2(5.0, 12.0);
const vec2 FOAM_STIR = vec2(1.5, 4.0);
// Churn (blocks^2/s): water flowing in times the head it loses here (surface drop plus the velocity head it sheds), per cell area.
// It is what turns water white: rapids down blocky slopes, a fast slope running into a pool (a hydraulic jump), a flood front,
// water piling against an obstacle. Calm rivers and lakes stay near 0 (HfCpuTest churn calibration: still lake 0, spreading front
// 3-6, cascading 1/3 slope 20-50, jump up to 90). Foam fades in over FOAM_CHURN, spray is thrown up above SPRAY_CHURN_MIN.
const vec2 FOAM_CHURN = vec2(1.5, 12.0);
const float FOAM_CHURN_MAX = 0.85;
const float SPRAY_CHURN_MIN = 8.0;
// Water counts as running, and keeps its tile awake even when its surface is steady, with an outflow above RUNNING_FLOW
// (blocks^3/s, the thinnest film and sheet hf_mesh.comp draws) at more than RUNNING_SPEED (blocks/s). The speed keeps a flood
// edge creeping out over flat ground (a few cm/s) from holding its tiles awake until it stops.
const float RUNNING_FLOW = HF_FILM_DRAW;
const float RUNNING_SPEED = 0.15;
// Droplets per second per span and unit of churn above SPRAY_CHURN_MIN (times hfSpray).
const float SPRAY_CHURN_RATE = 0.12;
// hfSpray while the water moves (0: no spray), the spray half to add to and a seed for this step.
#define HF_SPRAY_SCALE hp.p1.y
#define HF_SPRAY_INTO uint(hp.p2.z)
#define HF_SPRAY_SEED uint(hp.p2.w)

shared vec4 reduction[256];
shared uint borderBits;

// Bit d when span a holds water at its tile's border in direction d, has a link that way, and no tile exists there yet.
uint growthBits(HfSpan a, float h) {
    if (h <= HF_GROW_DEPTH) {
        return 0u;
    }
    ivec2 c = hfColumn(a.col);
    uint bits = 0u;
    for (uint d = 0u; d < 4u; d++) {
        ivec2 n = c + ivec2(HF_DX[d], HF_DZ[d]);
        bool outside = n.x < 0 || n.y < 0 || n.x >= HF_TN || n.y >= HF_TN;
        if (!outside || tileInfo[a.tile * 4u][d] >= 0) {
            continue;
        }
        if (hfLink(a, d * 2u) != HF_LINK_NONE || hfLink(a, d * 2u + 1u) != HF_LINK_NONE) {
            bits |= 1u << d;
        }
    }
    return bits;
}

void main() {
    uint lid = gl_LocalInvocationIndex;
    if (lid == 0u) {
        borderBits = 0u;
    }
    barrier();
    HfSpan a;
    bool have = hfFromList(GID_U, a);
    vec4 mine = vec4(0.0);
    if (have && hfValid(hfGeo(a.span))) {
        float inflow = 0.0;
        float outflow = 0.0;
        float peak = 0.0;
        float old = depth[a.span];
        float floorA = hfGeo(a.span).x;
        float foamA = foam[HF_FOAM_READ + hfFoamIndex(a)];
        float foamIn = 0.0;
        float falling = 0.0;
        // Water pouring in over a drop of more than HF_AIR_MIN_DROP (blocks^3/s, and times its drop).
        float airIn = 0.0;
        float airDrop = 0.0;
        float churn = 0.0;
        // Whether a neighbor deeper than hfRenderDepth has its surface at ours (we are the edge of that body).
        bool lake = false;
        // Our water's speed (its outflow over the old depth; the new one is not known yet) and where it goes.
        float outSum = 0.0;
        vec2 outDir = vec2(0.0);
        for (uint k = 0u; k < HF_LINKS; k++) {
            float o = flux[a.flux + k];
            outSum += o;
            outDir += o * vec2(HF_DX[k >> 1], HF_DZ[k >> 1]);
        }
        float ua = outSum / (HF_CELL * max(old, 0.05));
        for (uint k = 0u; k < HF_LINKS; k++) {
            uint nib = hfLink(a, k);
            HfSpan b;
            if (nib == HF_LINK_NONE || !hfNeighbor(a, k, nib, true, b)) {
                continue;
            }
            float o = flux[a.flux + k];
            float i = flux[b.flux + hfRev(k, nib)];
            float hb = depth[b.span];
            lake = lake || (hb > HF_RENDER_DEPTH && abs(hfGeo(b.span).x + hb - (floorA + old)) < 0.03);
            outflow += o;
            inflow += i;
            peak = max(peak, max(o, i));
            if (i > 0.0) {
                foamIn += i * foam[HF_FOAM_READ + hfFoamIndex(b)];
                // Water arriving from a span whose floor lies above our surface drops in: a waterfall or a step. Over a real
                // drop it is in the air first and churns the water where it lands, when it lands (below).
                float drop = hfGeo(b.span).x - (floorA + old);
                if (drop > HF_AIR_MIN_DROP) {
                    airIn += i;
                    airDrop += i * drop;
                } else if (drop > 0.0) {
                    falling += i * min(drop, 4.0);
                } else {
                    float hb = depth[b.span];
                    float ub = i / (HF_CELL * max(hb, 0.05));
                    float loss = hfGeo(b.span).x + hb - (floorA + old) + (ub * ub - ua * ua) / (2.0 * HF_AIR_G);
                    churn += i * clamp(loss, 0.0, 4.0);
                }
            }
        }
        float area = HF_CELL * HF_CELL;
        // Water in the air lands after its fall time (hfFallTime of its mean drop) from when it began falling in, then at a rate
        // that keeps volume x fall time in flight (steady pouring lands as fast as it pours); once the pouring stops the rest
        // lands over the same time. Before, water reached the foot of a high fall the moment it tipped over the edge.
        uint ai = a.span * HF_AIR_STRIDE;
        float airVol = air[ai];
        float airT = air[ai + 1u];
        float airH = air[ai + 2u];
        if (airIn > 0.0) {
            airH = airDrop / airIn;
            airVol += airIn * HF_DT;
        }
        float landed = 0.0;
        if (airVol > 0.0) {
            float tf = hfFallTime(airH);
            airT = min(airT + HF_DT, tf + 1000.0);
            if (airT >= tf) {
                landed = airVol * (1.0 - exp(-HF_DT / max(tf, 0.05)));
                if (airVol - landed < 1.0e-6) {
                    landed = airVol;
                }
                airVol -= landed;
            }
        }
        if (airVol <= 0.0) {
            // Nothing in the air: the next pour starts a new front from the top.
            airVol = 0.0;
            airT = 0.0;
        }
        air[ai] = airVol;
        air[ai + 1u] = airT;
        air[ai + 2u] = airH;
        falling += landed / HF_DT * min(airH, 4.0);
        float h = max(old + (HF_DT * (inflow - airIn - outflow) + landed) / area, 0.0);
        depth[a.span] = h;
        // How much of the water here is in the drawn surface (see hfPresenceTarget), moving at most 1 per HF_FILM_SWITCH seconds.
        float sv = air[ai + 3u];
        bool on = hfRunning(sv);
        float shown = hfShown(sv);
        on = max(outflow, inflow - airIn + landed / HF_DT) > HF_FILM_DRAW * (on ? 0.4 : 1.0);
        float target = hfPresenceTarget(h, on, outflow, lake);
        float step = HF_DT / HF_FILM_SWITCH;
        shown = target > shown ? min(target, shown + step) : max(target, shown - step);
        air[ai + 3u] = shown + (on ? 2.0 : 0.0) + (lake ? 4.0 : 0.0);
        // Thin films give meaningless speeds (flux / tiny depth), so they are left out of the CFL estimate.
        float speed = h > 0.05 ? min(peak / (HF_CELL * h), HF_MAX_SPEED) : 0.0;

        // Foam moves with the water (upwind, like the depth itself), fades, and is renewed where the water is churned.
        float mass = foamA * old + HF_DT * (foamIn - outflow * foamA) / area;
        float f = h > 1.0e-4 ? clamp(mass / h, 0.0, 1.0) * HF_FOAM_KEEP : 0.0;
        f = max(f, 0.9 * smoothstep(0.0, FOAM_FALL_RATE, falling / area));
        // Only water deep enough for its speed to mean something (thin films give huge flux / depth ratios).
        f = max(f, 0.35 * smoothstep(FOAM_FAST.x, FOAM_FAST.y, speed) * smoothstep(0.05, 0.2, h));
        float churnA = churn / area;
        f = max(f, FOAM_CHURN_MAX * smoothstep(FOAM_CHURN.x, FOAM_CHURN.y, churnA) * smoothstep(0.02, 0.1, h));
        if (HF_SPRAY_SCALE > 0.0 && churnA > SPRAY_CHURN_MIN && h > 0.03) {
            // Churning water throws droplets up and along with the current.
            uint s = sprayHash(a.span * 2654435761u ^ HF_SPRAY_SEED);
            int n = int(min(SPRAY_CHURN_RATE * (churnA - SPRAY_CHURN_MIN) * HF_DT * HF_SPRAY_SCALE + sprayRand(s), 4.0));
            if (n > 0) {
                vec2 origin = vec2(tileInfo[a.tile * 4u + 1u].xy * HF_TN + hfColumn(a.col)) * HF_CELL;
                vec2 current = outDir / (HF_CELL * max(h, 0.05));
                float cs = length(current);
                current *= cs > 8.0 ? 8.0 / cs : 1.0;
                float strength = 0.5 + sqrt(clamp((churnA - SPRAY_CHURN_MIN) / 40.0, 0.0, 1.0));
                for (int k = 0; k < n; k++) {
                    vec3 p = vec3(origin.x + sprayRand(s) * HF_CELL, floorA + h - float(HF_YMIN) + 0.03, origin.y + sprayRand(s) * HF_CELL);
                    float az = sprayRand(s) * 6.2831853;
                    float spread = mix(0.2, 1.0, sprayRand(s)) * strength;
                    vec3 v = vec3(current.x * mix(0.4, 0.9, sprayRand(s)) + cos(az) * spread, mix(1.0, 3.0, sprayRand(s)) * strength,
                        current.y * mix(0.4, 0.9, sprayRand(s)) + sin(az) * spread);
                    sprayAdd(HF_SPRAY_INTO, p, v, mix(0.4, 1.0, sprayRand(s)), SPRAY_DROPLET);
                }
            }
        }
        vec3 stir = hfStir(a, floorA, floorA + h);
        if (stir.z > 0.0) {
            f = max(f, 0.35 * smoothstep(FOAM_STIR.x, FOAM_STIR.y, length(stir.xy)));
        }
        foam[HF_FOAM_WRITE + hfFoamIndex(a)] = h > 0.0 ? f : 0.0;
        // Water still in the air counts toward the volume, and keeps the tile awake until it has landed. So does running water: a
        // steady stream has a still surface, and judged by that alone a tile carrying only a thin stream fell asleep (film tiles
        // may sleep below 0.02 b/s), stopped waking the tile downstream and dammed the stream at the border; its films and
        // sheets vanished and popped back whenever a surge woke it.
        bool busy = airVol > 1.0e-5 || (outflow > RUNNING_FLOW && outflow > RUNNING_SPEED * HF_CELL * max(h, 0.008));
        mine = vec4(h * HF_CELL * HF_CELL + airVol, h, speed, max(abs(h - old) / HF_DT, busy ? 1.0 : 0.0));
        uint bits = growthBits(a, h);
        if (bits != 0u) {
            atomicOr(borderBits, bits);
        }
    }
    reduction[lid] = mine;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (lid < stride) {
            vec4 m = reduction[lid];
            vec4 o = reduction[lid + stride];
            reduction[lid] = vec4(m.x + o.x, max(m.y, o.y), max(m.z, o.z), max(m.w, o.w));
        }
        barrier();
    }
    // Every group lies inside one page (pageSpans is a multiple of 256), so stats are kept per span page.
    uint first = GROUP_ID * 256u;
    uint idx = first / hfPageSpans();
    if (lid == 0u && idx < uint(HF_COUNT)) {
        uint e = pageList[idx];
        uint page = uint(tileInfo[(e >> 2) * 4u + 2u][e & 3u]);
        uint entry = page * (hfPageSpans() / 256u) + (first % hfPageSpans()) / 256u;
        stats[entry * 2u] = reduction[0];
        stats[entry * 2u + 1u] = vec4(uintBitsToFloat(borderBits), 0.0, 0.0, 0.0);
    }
}
