#version 450
// Reservoirs, applied after every depth pass to simulated tiles: the edges of a captured area where the water continues outside
// (an ocean or a river) and springs (at the top of the spring block) are held at their level (mode 0); mode 1 only fills up.
// Entries are (tile, column, level as float bits, mode).
#include "hf_common.glsl"
layout(local_size_x = 64) in;
layout(std430, binding = 2) buffer Depth { float depth[]; };
layout(std430, binding = 14) readonly buffer Aux { ivec4 entries[]; };
// The water reservoirs add (springs) or remove (open edges) is summed into one int past the per-page stats, in 1/65536 blocks^3,
// so /water hf stats can tell water that came from a spring from water the solver lost or made (HfDomain.readStats).
layout(std430, binding = 8) buffer Stats { int statsInt[]; };
#define HF_CELL hp.p0.x
#define HF_VOLUME_SLOT uint(hp.p2.x)
const float VOLUME_UNIT = 65536.0;

void main() {
    uint i = GID_U;
    if (i >= uint(HF_COUNT)) {
        return;
    }
    ivec4 e = entries[i];
    uint tile = uint(e.x);
    if (tileActive[tile] == 0u) {
        return;
    }
    float level = intBitsToFloat(e.z);
    for (uint l = 0u; l < 4u; l++) {
        int page = tileInfo[tile * 4u + 2u][l];
        if (page < 0) {
            continue;
        }
        uint s = uint(page) * hfPageSpans() + uint(e.y);
        vec2 g = hfGeo(s);
        if (!hfValid(g) || !(g.x < level && level <= g.y)) {
            continue;
        }
        float target = level - g.x;
        float old = depth[s];
        float now = e.w == 0 ? target : max(old, target);
        depth[s] = now;
        int dv = int(round((now - old) * HF_CELL * HF_CELL * VOLUME_UNIT));
        if (dv != 0) {
            atomicAdd(statsInt[HF_VOLUME_SLOT], dv);
        }
        return;
    }
}
