#version 450
// Builds the heightfield water mesh in the same format SurfaceMesher produces (verts = position + packed normal,
// quads = 4 vertex indices, meshCounters[1] = quad count), so WaterRenderer can draw and shade it unchanged.
//
// Every wet span emits its top surface and side walls where the neighbor is dry or blocked, but no bottom: every vertex
// carries the OPEN flag, and mesh_thickness.frag closes open shapes at the scene depth (the riverbed). That halves the
// geometry and removes a full layer of overdraw from the additive thickness pass.
#include "hf_common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 1) readonly buffer Geo { vec2 geo[]; };
layout(std430, binding = 2) readonly buffer Depth { float depth[]; };
layout(std430, binding = 9) writeonly buffer Verts { vec4 verts[]; };
layout(std430, binding = 10) writeonly buffer Quads { uvec4 quads[]; };
layout(std430, binding = 11) buffer MeshCounters { uint meshCounters[]; };

#define HF_CELL hp.p0.z
#define HF_ORIGIN_Y hp.p0.w
#define HF_RENDER_DRY hp.p1.y
#define HF_QUAD_CAP uint(hp.p2.x)

const uint OPEN = 0x80000000u;
const float WALL_INSET = 0.01;

bool wet(uint t) {
    return depth[t] > HF_RENDER_DRY;
}

float surfaceOf(uint t) {
    return min(geo[t].x + depth[t], geo[t].y);
}

// Two wet spans form one water surface only when their water columns overlap in height. A link only says the open spaces
// overlap: ground water next to a puddle on a roof is linked too, and averaging the two would draw slanted sheets up the wall.
bool joined(uint a, uint t) {
    return wet(t) && geo[t].x < surfaceOf(a) && geo[a].x < surfaceOf(t);
}

// Neighbor span in a direction, preferring one whose water joins ours. Slot j = 0 holds the largest opening.
uint pick(uint s, int dir) {
    uint fallback = HF_NONE;
    for (int j = 0; j < 2; j++) {
        uint k = uint(dir * 2 + j);
        uint l = hfLink(s, k);
        if (l == HF_LINK_NONE) {
            continue;
        }
        // Sleeping tiles still show their water, so neighbors resolve by existence, not by activity.
        uint t = hfNeighbor(s, k, l, false);
        if (t == HF_NONE) {
            continue;
        }
        if (joined(s, t)) {
            return t;
        }
        if (fallback == HF_NONE) {
            fallback = t;
        }
    }
    return fallback;
}

float sampleHeight(uint s, uint t, float fl, float top) {
    if (t == HF_NONE) {
        return top;
    }
    if (wet(t)) {
        // Water at a different level (a roof, a ledge, the top of a waterfall) is a separate surface: keep our own height.
        return joined(s, t) ? surfaceOf(t) : top;
    }
    // A dry neighbor pulls toward its floor (shorelines), but never below our floor or above our surface.
    return clamp(geo[t].x, fl, top);
}

// Height and smooth normal at one corner, from the (up to) four spans sharing it. Adjacent quads compute the same
// values, so they meet without cracks and shade without visible facets.
vec4 corner(uint s, int sx, int sz, float fl, float top, float ce) {
    int dirX = sx > 0 ? 0 : 1;
    int dirZ = sz > 0 ? 2 : 3;
    uint nx = pick(s, dirX);
    uint nz = pick(s, dirZ);
    uint nd = nx != HF_NONE ? pick(nx, dirZ) : HF_NONE;
    if (nd == HF_NONE && nz != HF_NONE) {
        nd = pick(nz, dirX);
    }
    float hs = top;
    float hx = sampleHeight(s, nx, fl, top);
    float hz = sampleHeight(s, nz, fl, top);
    float hd = nd != HF_NONE ? sampleHeight(s, nd, fl, top) : 0.5 * (hx + hz);
    float c = HF_CELL;
    float dhdx = ((hx - hs) + (hd - hz)) * 0.5 / c * float(sx);
    float dhdz = ((hz - hs) + (hd - hx)) * 0.5 / c * float(sz);
    float h = clamp(0.25 * (hs + hx + hz + hd), fl, ce);
    vec3 n = normalize(vec3(-dhdx, 1.0, -dhdz));
    return vec4(n.x, h, n.z, 0.0);
}

vec3 cornerNormal(vec4 c) {
    return normalize(vec3(c.x, sqrt(max(1.0 - c.x * c.x - c.z * c.z, 1e-4)), c.z));
}

void emitTop(uint q, vec3 a, vec3 b, vec3 c, vec3 d, vec3 na, vec3 nb, vec3 nc, vec3 nd) {
    if (q >= HF_QUAD_CAP) {
        return;
    }
    uint v = q * 4u;
    verts[v] = vec4(a, uintBitsToFloat(packNormal(na, false) | OPEN));
    verts[v + 1u] = vec4(b, uintBitsToFloat(packNormal(nb, false) | OPEN));
    verts[v + 2u] = vec4(c, uintBitsToFloat(packNormal(nc, false) | OPEN));
    verts[v + 3u] = vec4(d, uintBitsToFloat(packNormal(nd, false) | OPEN));
    quads[q] = uvec4(v, v + 1u, v + 2u, v + 3u);
}

void emit(uint q, vec3 a, vec3 b, vec3 c, vec3 d, vec3 normal, bool wall) {
    if (q >= HF_QUAD_CAP) {
        return;
    }
    float packed = uintBitsToFloat(packNormal(normal, wall) | OPEN);
    uint v = q * 4u;
    verts[v] = vec4(a, packed);
    verts[v + 1u] = vec4(b, packed);
    verts[v + 2u] = vec4(c, packed);
    verts[v + 3u] = vec4(d, packed);
    quads[q] = uvec4(v, v + 1u, v + 2u, v + 3u);
}

void main() {
    uint s = hfSpanOf(GID_U, false);
    if (s == HF_NONE) {
        return;
    }
    vec2 g = geo[s];
    if (!hfValid(g) || !wet(s)) {
        return;
    }
    ivec2 tile = tileInfo[(s / uint(HF_TILE_SPANS)) * 2u + 1u].xy;
    ivec2 local = hfColumn(s);
    int cx = tile.x * HF_TN + local.x;
    int cz = tile.y * HF_TN + local.y;
    float fl = g.x;
    float ce = g.y;
    float top = surfaceOf(s);
    float oy = HF_ORIGIN_Y;

    vec4 c00 = corner(s, -1, -1, fl, top, ce);
    vec4 c10 = corner(s, 1, -1, fl, top, ce);
    vec4 c11 = corner(s, 1, 1, fl, top, ce);
    vec4 c01 = corner(s, -1, 1, fl, top, ce);
    float h00 = c00.y - oy;
    float h10 = c10.y - oy;
    float h11 = c11.y - oy;
    float h01 = c01.y - oy;

    uint wallMask = 0u;
    float inset[4];
    for (int d = 0; d < 4; d++) {
        uint t = pick(s, d);
        inset[d] = t == HF_NONE ? WALL_INSET : 0.0;
        if (t == HF_NONE || !joined(s, t)) {
            wallMask |= 1u << d;
        }
    }
    uint count = 1u + uint(bitCount(wallMask));
    uint q = atomicAdd(meshCounters[1], count);
    if (q >= HF_QUAD_CAP) {
        return;
    }

    float c = HF_CELL;
    float x0 = float(cx) * c;
    float x1 = x0 + c;
    float z0 = float(cz) * c;
    float z1 = z0 + c;
    float b = fl - oy;

    emitTop(q++, vec3(x0, h00, z0), vec3(x1, h10, z0), vec3(x1, h11, z1), vec3(x0, h01, z1),
        cornerNormal(c00), cornerNormal(c10), cornerNormal(c11), cornerNormal(c01));
    if ((wallMask & 1u) != 0u) {
        float x = x1 - inset[0];
        emit(q++, vec3(x, b, z0), vec3(x, b, z1), vec3(x, h11, z1), vec3(x, h10, z0), vec3(1.0, 0.0, 0.0), true);
    }
    if ((wallMask & 2u) != 0u) {
        float x = x0 + inset[1];
        emit(q++, vec3(x, b, z1), vec3(x, b, z0), vec3(x, h00, z0), vec3(x, h01, z1), vec3(-1.0, 0.0, 0.0), true);
    }
    if ((wallMask & 4u) != 0u) {
        float z = z1 - inset[2];
        emit(q++, vec3(x1, b, z), vec3(x0, b, z), vec3(x0, h01, z), vec3(x1, h11, z), vec3(0.0, 0.0, 1.0), true);
    }
    if ((wallMask & 8u) != 0u) {
        float z = z0 + inset[3];
        emit(q++, vec3(x0, b, z), vec3(x1, b, z), vec3(x1, h10, z), vec3(x0, h00, z), vec3(0.0, 0.0, -1.0), true);
    }
}
