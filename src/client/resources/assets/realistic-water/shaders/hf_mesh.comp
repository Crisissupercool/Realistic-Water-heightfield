#version 450
// Builds the heightfield water mesh in the same format SurfaceMesher produces (verts = position + packed normal,
// quads = 4 vertex indices, meshCounters[1] = quad count), so WaterRenderer can draw and shade it unchanged.
//
// Every wet span emits its top surface and side walls where the neighbor is dry or blocked, but no bottom: every vertex
// carries the OPEN flag, and mesh_thickness.frag closes open shapes at the scene depth (the riverbed). That halves the
// geometry and removes a full layer of overdraw from the additive thickness pass.
#include "hf_common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 2) readonly buffer Depth { float depth[]; };
layout(std430, binding = 3) readonly buffer Flux { float flux[]; };
layout(std430, binding = 9) writeonly buffer Verts { vec4 verts[]; };
layout(std430, binding = 10) writeonly buffer Quads { uvec4 quads[]; };
layout(std430, binding = 11) buffer MeshCounters { uint meshCounters[]; };

// Vanilla draws a full water block 1/9 below its top; the heightfield surface is lowered the same (scaled down in shallow water).
#define HF_SURFACE_DROP hp.p0.x
// Outflow (blocks^3/s) over a drop above which a falling sheet is drawn.
#define HF_CURTAIN_MIN hp.p0.y
#define HF_CELL hp.p0.z
#define HF_ORIGIN_Y hp.p0.w
#define HF_RENDER_DRY hp.p1.y
#define HF_QUAD_CAP uint(hp.p2.x)
// WaterSettings.hfDebugMesh: 0 normal, 1 tops only (no side walls), 2 side walls only.
#define HF_DEBUG int(hp.p1.w)
// WaterSettings.hfFoam (how white foam shows) and the half of the foam buffer the last solver step wrote.
#define HF_FOAM_GAIN hp.p1.x
#define HF_FOAM_READ uint(hp.p2.y)

const uint OPEN = 0x80000000u;
const float WALL_INSET = 0.01;
const float CURTAIN_OUT = 0.06;
// Falling sheets are drawn as a few segments along the arc water takes when it leaves an edge.
const int CURTAIN_SEGMENTS = 3;
const float CURTAIN_MAX_THROW = 0.3;
const float GRAVITY = 9.81;

// Heightfield vertices (OPEN set): 12 + 12 bit octahedral normal, 6 bit aeration (foam, falling water), wall flag, OPEN.
// mesh.vert decodes this; the fluid meshes keep packNormal's format (OPEN clear).
uint hfPack(vec3 n, bool wall, float aer) {
    n /= abs(n.x) + abs(n.y) + abs(n.z);
    vec2 e = n.z >= 0.0 ? n.xy : (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    uvec2 q = uvec2(clamp(e * 0.5 + 0.5, 0.0, 1.0) * 4095.0 + 0.5);
    uint a = uint(clamp(aer * HF_FOAM_GAIN, 0.0, 1.0) * 63.0 + 0.5);
    return q.x | (q.y << 12) | (a << 24) | (wall ? 0x40000000u : 0u) | OPEN;
}

float foamOf(HfSpan t) {
    return t.flux == HF_NONE ? 0.0 : foam[HF_FOAM_READ + hfFoamIndex(t)];
}

// Water below this is never drawn; between this and HF_RENDER_DRY it is drawn only while it moves.
const float FLOW_DRY = 0.008;

// Whether span t has water worth drawing. Still films under HF_RENDER_DRY stay hidden (they shimmered on flat ground), but a
// thin layer that is moving (running down steps or a slope) is drawn: hiding it punched holes cell by cell into shallow
// streams, which then looked like scattered pieces instead of a flow.
bool wet(uint t) {
    float d = depth[t];
    if (d > HF_RENDER_DRY) {
        return true;
    }
    if (d <= FLOW_DRY) {
        return false;
    }
    uint ps = hfPageSpans();
    int owner = pageOwner[t / ps];
    if (owner < 0) {
        return false;
    }
    int fp = tileInfo[uint(owner >> 2) * 4u + 3u][owner & 3];
    if (fp < 0) {
        return false;
    }
    uint f = (uint(fp) * ps + t % ps) * HF_LINKS;
    float outflow = 0.0;
    for (uint k = 0u; k < HF_LINKS; k++) {
        outflow += flux[f + k];
    }
    return outflow > 0.002;
}

float surfaceOf(uint t) {
    vec2 g = hfGeo(t);
    return min(g.x + depth[t], g.y);
}

// Two wet spans form one water surface only when their water columns overlap in height. A link only says the open spaces
// overlap: ground water next to a puddle on a roof is linked too, and averaging the two would draw slanted sheets up the wall.
bool joined(uint a, uint t) {
    return wet(t) && hfGeo(t).x < surfaceOf(a) && hfGeo(a).x < surfaceOf(t);
}

// Spans whose surfaces differ by up to this much and that exchange water are drawn as one sloped surface (a ramp of
// flowing water over a step) instead of two separate pieces with a sheet between them; bigger drops get a falling sheet.
const float RAMP_MAX_DROP = 1.6;
const float RAMP_MIN_FLOW = 0.02;

float outflowTo(HfSpan a, int dir) {
    return a.flux == HF_NONE ? 0.0 : flux[a.flux + uint(dir * 2)] + flux[a.flux + uint(dir * 2 + 1)];
}

// Whether a and its neighbor t in direction dir are drawn as one surface: their water columns overlap (joined), or water flows
// between them over a small drop. Symmetric, so both sides compute the same shared corners and the surface has no cracks.
bool linked(HfSpan a, int dir, HfSpan t) {
    // Both must be wet: joined() alone only checks t, which made the relation one-sided next to dry spans.
    if (!wet(a.span) || !wet(t.span)) {
        return false;
    }
    if (joined(a.span, t.span)) {
        return true;
    }
    if (abs(surfaceOf(a.span) - surfaceOf(t.span)) > RAMP_MAX_DROP) {
        return false;
    }
    return outflowTo(a, dir) + outflowTo(t, dir ^ 1) > RAMP_MIN_FLOW;
}

// Neighbor span in a direction, preferring one drawn as the same surface as ours. Slot j = 0 holds the largest opening.
bool pick(HfSpan a, int dir, out HfSpan r) {
    bool found = false;
    for (int j = 0; j < 2; j++) {
        uint k = uint(dir * 2 + j);
        uint nib = hfLink(a, k);
        HfSpan t;
        // Sleeping tiles still show their water, so neighbors resolve by existence, not by activity.
        if (nib == HF_LINK_NONE || !hfNeighbor(a, k, nib, false, t)) {
            continue;
        }
        if (linked(a, dir, t)) {
            r = t;
            return true;
        }
        if (!found) {
            r = t;
            found = true;
        }
    }
    return found;
}

// What a neighbor at one of our corners adds: a linked span its surface, dry ground a shoreline height (toward its floor, but
// within the corner's water; over a drop most of the water depth stays up to the brink, where it pours off). Walls and water
// at a separate level add nothing (NaN). Everything is relative to the corner's water, not to our own span, so every span
// sharing the corner gets the same height and the surface has no cracks.
float cornerSample(bool ok, bool link, HfSpan t, float lo, float level) {
    if (!ok) {
        return uintBitsToFloat(0x7FC00000u);
    }
    if (link) {
        return surfaceOf(t.span);
    }
    if (wet(t.span)) {
        return uintBitsToFloat(0x7FC00000u);
    }
    float nf = hfGeo(t.span).x;
    if (nf < lo - 0.05) {
        return mix(lo, level, 0.7);
    }
    return clamp(nf, lo, level);
}

// Height, smooth normal and foam at one corner, from the (up to) four spans sharing it: the average over our span, the spans
// linked to it and shoreline samples from dry neighbors. A ramp corner may lie below our own floor (down to the lowest linked
// floor); the vanilla-like surface drop uses the corner's water depth.
vec4 corner(HfSpan a, int sx, int sz, float fl, float top, float ce) {
    int dirX = sx > 0 ? 0 : 1;
    int dirZ = sz > 0 ? 2 : 3;
    HfSpan nx;
    HfSpan nz;
    HfSpan nd;
    bool okX = pick(a, dirX, nx);
    bool okZ = pick(a, dirZ, nz);
    bool eSX = okX && linked(a, dirX, nx);
    bool eSZ = okZ && linked(a, dirZ, nz);
    // The diagonal span, reached through either side. The corner's water is the part of the four-span loop S-X-D-Z connected to
    // us, so every span sharing the corner finds the same set (a one-sided "via x only" rule left cracks on uneven slopes).
    HfSpan dx;
    HfSpan dz;
    bool okDX = okX && pick(nx, dirZ, dx);
    bool okDZ = okZ && pick(nz, dirX, dz);
    bool eXD = okDX && linked(nx, dirZ, dx);
    bool eZD = okDZ && linked(nz, dirX, dz);
    bool okD = okDX || okDZ;
    bool same = okDX && okDZ && dx.span == dz.span;
    if (okDX && (eXD || !(okDZ && eZD))) {
        nd = dx;
        eZD = same && eZD;
    } else if (okDZ) {
        nd = dz;
        eXD = same && eXD;
    }
    bool lx = eSX || (eSZ && eZD && eXD);
    bool lz = eSZ || (eSX && eXD && eZD);
    bool ld = (eSX && eXD) || (eSZ && eZD);
    // The corner's water: our span and the spans linked to it.
    float levelSum = top;
    float lo = fl;
    float hiC = ce;
    float depthSum = top - fl;
    float aer = foamOf(a);
    float shares = 1.0;
    if (lx) {
        vec2 gx = hfGeo(nx.span);
        levelSum += surfaceOf(nx.span);
        lo = min(lo, gx.x);
        hiC = min(hiC, gx.y);
        depthSum += surfaceOf(nx.span) - gx.x;
        aer += foamOf(nx);
        shares += 1.0;
    }
    if (lz) {
        vec2 gz = hfGeo(nz.span);
        levelSum += surfaceOf(nz.span);
        lo = min(lo, gz.x);
        hiC = min(hiC, gz.y);
        depthSum += surfaceOf(nz.span) - gz.x;
        aer += foamOf(nz);
        shares += 1.0;
    }
    if (ld) {
        vec2 gd = hfGeo(nd.span);
        levelSum += surfaceOf(nd.span);
        lo = min(lo, gd.x);
        hiC = min(hiC, gd.y);
        depthSum += surfaceOf(nd.span) - gd.x;
        aer += foamOf(nd);
        shares += 1.0;
    }
    float level = levelSum / shares;
    float hx = cornerSample(okX, lx, nx, lo, level);
    float hz = cornerSample(okZ, lz, nz, lo, level);
    float hd = cornerSample(okD, ld, nd, lo, level);
    float sum = top;
    float count = 1.0;
    if (!isnan(hx)) {
        sum += hx;
        count += 1.0;
    }
    if (!isnan(hz)) {
        sum += hz;
        count += 1.0;
    }
    if (!isnan(hd)) {
        sum += hd;
        count += 1.0;
    }
    float h = sum / count;
    // Missing samples take the corner height, so the slope comes only from what is there (and matches on every side).
    float hs = top;
    hx = isnan(hx) ? h : hx;
    hz = isnan(hz) ? h : hz;
    hd = isnan(hd) ? h : hd;
    float c = HF_CELL;
    float dhdx = ((hx - hs) + (hd - hz)) * 0.5 / c * float(sx);
    float dhdz = ((hz - hs) + (hd - hx)) * 0.5 / c * float(sz);
    h = clamp(h, lo, hiC);
    h -= HF_SURFACE_DROP * clamp(min(depthSum / shares, h - lo), 0.0, 1.0);
    vec3 n = normalize(vec3(-dhdx, 1.0, -dhdz));
    return vec4(n.x, h, n.z, aer / shares);
}

vec3 cornerNormal(vec4 c) {
    return normalize(vec3(c.x, sqrt(max(1.0 - c.x * c.x - c.z * c.z, 1e-4)), c.z));
}

void emitTop(uint q, vec3 a, vec3 b, vec3 c, vec3 d, vec4 ca, vec4 cb, vec4 cc, vec4 cd) {
    if (q >= HF_QUAD_CAP) {
        return;
    }
    uint v = q * 4u;
    verts[v] = vec4(a, uintBitsToFloat(hfPack(cornerNormal(ca), false, ca.w)));
    verts[v + 1u] = vec4(b, uintBitsToFloat(hfPack(cornerNormal(cb), false, cb.w)));
    verts[v + 2u] = vec4(c, uintBitsToFloat(hfPack(cornerNormal(cc), false, cc.w)));
    verts[v + 3u] = vec4(d, uintBitsToFloat(hfPack(cornerNormal(cd), false, cd.w)));
    quads[q] = uvec4(v, v + 1u, v + 2u, v + 3u);
}

void emit(uint q, vec3 a, vec3 b, vec3 c, vec3 d, vec3 normal, bool wall) {
    if (q >= HF_QUAD_CAP) {
        return;
    }
    float packed = uintBitsToFloat(hfPack(normal, wall, 0.0));
    uint v = q * 4u;
    verts[v] = vec4(a, packed);
    verts[v + 1u] = vec4(b, packed);
    verts[v + 2u] = vec4(c, packed);
    verts[v + 3u] = vec4(d, packed);
    quads[q] = uvec4(v, v + 1u, v + 2u, v + 3u);
}

// Whether span t pours over its edge in direction d as a falling sheet: the water it flows into lies below its floor and the
// outflow is above HF_CURTAIN_MIN. land: where it lands (world y); throwOut: how far it flies out leaving the edge at its
// overflow speed; q: the outflow (blocks^3/s).
bool curtainOf(HfSpan t, int d, out float land, out float throwOut, out float q) {
    land = 0.0;
    throwOut = 0.0;
    q = 0.0;
    HfSpan n;
    if (t.flux == HF_NONE || !pick(t, d, n) || linked(t, d, n)) {
        return false;
    }
    float fl = hfGeo(t.span).x;
    land = wet(n.span) ? surfaceOf(n.span) : hfGeo(n.span).x;
    q = flux[t.flux + uint(d * 2)] + flux[t.flux + uint(d * 2 + 1)];
    if (land >= fl - 0.05 || q <= HF_CURTAIN_MIN) {
        return false;
    }
    float top = surfaceOf(t.span);
    float speed = min(q / (HF_CELL * max(top - fl, 0.03)), 4.0);
    throwOut = min(speed * sqrt(2.0 * (top - land) / GRAVITY), CURTAIN_MAX_THROW);
    return true;
}

// End of a sheet at a corner shared with the neighbor across side direction sd: when that neighbor's water joins ours and pours
// over the same edge, both sheets use the average landing and throw there, so side by side sheets meet as one curtain instead
// of a row of separate arches.
vec2 curtainEnd(HfSpan a, int d, int sd, float land, float throwOut) {
    HfSpan n;
    float nl;
    float nt;
    float nq;
    if (pick(a, sd, n) && linked(a, sd, n) && curtainOf(n, d, nl, nt, nq)) {
        return vec2(0.5 * (land + nl), 0.5 * (throwOut + nt));
    }
    return vec2(land, throwOut);
}

// A falling sheet from the brink e0..e1 (xz at the edge, y = water height there; ends: landing height, throw) thrown outward.
// Each segment is one quad; vertices follow y = top - (top - land) s^2, distance out = CURTAIN_OUT + throw s, with the arc's
// normal. Thin trickles stay clearer than full sheets.
void emitCurtain(uint q, vec2 outward, vec3 e0, vec3 e1, vec2 end0, vec2 end1, float flow, float aerTop) {
    vec3 dir = vec3(outward.x, 0.0, outward.y);
    float body = 0.35 + 0.65 * smoothstep(0.01, 0.25, flow);
    for (int i = 0; i < CURTAIN_SEGMENTS; i++) {
        if (q >= HF_QUAD_CAP) {
            return;
        }
        uint v = q * 4u;
        for (int j = 0; j < 4; j++) {
            // Vertex order bottom e0, bottom e1, top e1, top e0, so the face points out like the side walls.
            float s = float(i + (j < 2 ? 1 : 0)) / float(CURTAIN_SEGMENTS);
            bool first = j == 0 || j == 3;
            vec3 e = first ? e0 : e1;
            vec2 end = first ? end0 : end1;
            float h = max(e.y - end.x, 0.0);
            vec3 p = vec3(e.x, e.y - h * s * s, e.z) + dir * (CURTAIN_OUT + end.y * s);
            vec3 n = normalize(dir * max(2.0 * h * s, 0.25) + vec3(0.0, end.y, 0.0));
            float aerBottom = clamp(0.3 + 0.25 * h, 0.3, 0.95) * body;
            float aer = max(mix(aerTop * body, aerBottom, s), 0.1);
            verts[v + uint(j)] = vec4(p, uintBitsToFloat(hfPack(n, true, aer)));
        }
        quads[q] = uvec4(v, v + 1u, v + 2u, v + 3u);
        q++;
    }
}

void main() {
    HfSpan a;
    if (!hfFromPage(GID_U, a)) {
        return;
    }
    uint s = a.span;
    vec2 g = hfGeo(s);
    if (!hfValid(g) || !wet(s)) {
        return;
    }
    ivec2 tile = tileInfo[a.tile * 4u + 1u].xy;
    ivec2 local = hfColumn(a.col);
    int cx = tile.x * HF_TN + local.x;
    int cz = tile.y * HF_TN + local.y;
    float fl = g.x;
    float ce = g.y;
    float top = surfaceOf(s);
    float oy = HF_ORIGIN_Y;

    vec4 c00 = corner(a, -1, -1, fl, top, ce);
    vec4 c10 = corner(a, 1, -1, fl, top, ce);
    vec4 c11 = corner(a, 1, 1, fl, top, ce);
    vec4 c01 = corner(a, -1, 1, fl, top, ce);
    float h00 = c00.y - oy;
    float h10 = c10.y - oy;
    float h11 = c11.y - oy;
    float h01 = c01.y - oy;

    uint wallMask = 0u;
    uint curtainMask = 0u;
    float inset[4];
    float curtainLand[4];
    float curtainThrow[4];
    float curtainFlow[4];
    for (int d = 0; d < 4; d++) {
        HfSpan t;
        bool ok = pick(a, d, t);
        inset[d] = ok ? 0.0 : WALL_INSET;
        if (!ok || !linked(a, d, t)) {
            wallMask |= 1u << d;
        }
        // Water pouring over an edge onto lower ground or into lower water: a falling sheet down to where it lands.
        if (curtainOf(a, d, curtainLand[d], curtainThrow[d], curtainFlow[d])) {
            curtainMask |= 1u << d;
        }
    }
    if (HF_DEBUG == 1) {
        wallMask = 0u;
    }
    bool drawTop = HF_DEBUG != 2;
    uint count = (drawTop ? 1u : 0u) + uint(bitCount(wallMask)) + uint(bitCount(curtainMask) * CURTAIN_SEGMENTS);
    if (count == 0u) {
        return;
    }
    uint q = atomicAdd(meshCounters[1], count);
    if (q >= HF_QUAD_CAP) {
        return;
    }

    float c = HF_CELL;
    float x0 = float(cx) * c;
    float x1 = x0 + c;
    float z0 = float(cz) * c;
    float z1 = z0 + c;
    float b = fl - oy;

    if (drawTop) emitTop(q++, vec3(x0, h00, z0), vec3(x1, h10, z0), vec3(x1, h11, z1), vec3(x0, h01, z1), c00, c10, c11, c01);
    if ((wallMask & 1u) != 0u) {
        float x = x1 - inset[0];
        emit(q++, vec3(x, b, z0), vec3(x, b, z1), vec3(x, h11, z1), vec3(x, h10, z0), vec3(1.0, 0.0, 0.0), true);
    }
    if ((wallMask & 2u) != 0u) {
        float x = x0 + inset[1];
        emit(q++, vec3(x, b, z1), vec3(x, b, z0), vec3(x, h00, z0), vec3(x, h01, z1), vec3(-1.0, 0.0, 0.0), true);
    }
    if ((wallMask & 4u) != 0u) {
        float z = z1 - inset[2];
        emit(q++, vec3(x1, b, z), vec3(x0, b, z), vec3(x0, h01, z), vec3(x1, h11, z), vec3(0.0, 0.0, 1.0), true);
    }
    if ((wallMask & 8u) != 0u) {
        float z = z0 + inset[3];
        emit(q++, vec3(x0, b, z), vec3(x1, b, z), vec3(x1, h10, z), vec3(x0, h00, z), vec3(0.0, 0.0, -1.0), true);
    }
    float aerTop = foamOf(a);
    uint seg = uint(CURTAIN_SEGMENTS);
    // Per edge: its two corners and the side direction each corner is shared across (see curtainEnd).
    const int SIDE0[4] = int[](3, 2, 0, 1);
    const int SIDE1[4] = int[](2, 3, 1, 0);
    vec3 e0s[4] = vec3[](vec3(x1, h10, z0), vec3(x0, h01, z1), vec3(x1, h11, z1), vec3(x0, h00, z0));
    vec3 e1s[4] = vec3[](vec3(x1, h11, z1), vec3(x0, h00, z0), vec3(x0, h01, z1), vec3(x1, h10, z0));
    const vec2 OUTWARD[4] = vec2[](vec2(1.0, 0.0), vec2(-1.0, 0.0), vec2(0.0, 1.0), vec2(0.0, -1.0));
    for (int d = 0; d < 4; d++) {
        if ((curtainMask & (1u << d)) == 0u) {
            continue;
        }
        vec2 end0 = curtainEnd(a, d, SIDE0[d], curtainLand[d], curtainThrow[d]);
        vec2 end1 = curtainEnd(a, d, SIDE1[d], curtainLand[d], curtainThrow[d]);
        end0.x -= oy;
        end1.x -= oy;
        emitCurtain(q, OUTWARD[d], e0s[d], e1s[d], end0, end1, curtainFlow[d], aerTop);
        q += seg;
    }
}
