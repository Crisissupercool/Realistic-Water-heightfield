#version 450
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
// Builds the heightfield water mesh in the same format SurfaceMesher produces (verts = position + packed normal,
// quads = 4 vertex indices, meshCounters[1] = quad count), so WaterRenderer can draw and shade it unchanged.
//
// Every wet span emits its top surface and side walls where the neighbor is dry or blocked, but no bottom: every vertex
// carries the OPEN flag, and mesh_thickness.frag closes open shapes at the scene depth (the riverbed). That halves the
// geometry and removes a full layer of overdraw from the additive thickness pass.
#include "hf_common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 2) readonly buffer Depth { float depth[]; };
layout(std430, binding = 3) readonly buffer Flux { float flux[]; };
layout(std430, binding = 9) writeonly buffer Verts { vec4 verts[]; };
layout(std430, binding = 10) writeonly buffer Quads { uvec4 quads[]; };
layout(std430, binding = 11) buffer MeshCounters { uint meshCounters[]; };
// Water velocity (blocks/s, horizontal) per vertex as packed halves, for flow-mapped foam and ripples in composite.frag.
layout(std430, binding = 16) writeonly buffer VertFlow { uint vertFlow[]; };

// Vanilla draws a full water block 1/9 below its top; the heightfield surface is lowered the same (scaled down in shallow water).
#define HF_SURFACE_DROP hp.p0.x
// Outflow (blocks^3/s) over a drop above which a falling sheet is drawn.
#define HF_CURTAIN_MIN hp.p0.y
#define HF_CELL hp.p0.z
#define HF_ORIGIN_Y hp.p0.w
#define HF_RENDER_DRY hp.p1.y
#define HF_QUAD_CAP uint(hp.p2.x)
// WaterSettings.hfDebugMesh: 0 normal, 1 tops only (no side walls), 2 side walls only.
#define HF_DEBUG int(hp.p1.w)
// WaterSettings.hfFoam (how white foam shows) and the half of the foam buffer the last solver step wrote.
#define HF_FOAM_GAIN hp.p1.x
#define HF_FOAM_READ uint(hp.p2.y)
// Seconds of water motion to emit spray for this frame (times WaterSettings.hfSpray; 0: none), the spray half to emit into, a seed.
#define HF_SPRAY_DT hp.p1.z
#define HF_SPRAY_INTO uint(hp.p2.z)
#define HF_SPRAY_SEED uint(hp.p2.w)

#include "hf_spray.glsl"

const uint OPEN = 0x80000000u;
const float WALL_INSET = 0.01;
// Falling sheets are drawn as segments along the path water takes when it leaves an edge. Segment ends as fractions of the fall
// time: dense at the lip, where the water curls over the edge, sparse lower down where it falls almost straight.
const int CURTAIN_SEGMENTS = 6;
const float CURTAIN_T[7] = float[](0.0, 0.05, 0.13, 0.26, 0.45, 0.7, 1.0);
// The farthest a sheet gets from its edge: it lands in the next cell, which is where the solver puts its water.
const float CURTAIN_REACH = 0.42;
const float GRAVITY = 9.81;

// Heightfield vertices (OPEN set): 12 + 12 bit octahedral normal, 6 bit aeration (foam, falling water), wall flag, OPEN.
// mesh.vert decodes this; the fluid meshes keep packNormal's format (OPEN clear).
uint hfPack(vec3 n, bool wall, float aer) {
    n /= abs(n.x) + abs(n.y) + abs(n.z);
    vec2 e = n.z >= 0.0 ? n.xy : (1.0 - abs(n.yx)) * vec2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    uvec2 q = uvec2(clamp(e * 0.5 + 0.5, 0.0, 1.0) * 4095.0 + 0.5);
    uint a = uint(clamp(aer * HF_FOAM_GAIN, 0.0, 1.0) * 63.0 + 0.5);
    return q.x | (q.y << 12) | (a << 24) | (wall ? 0x40000000u : 0u) | OPEN;
}

// Foam on a span, fading out on thin films: a few centimetres of water running over a step cannot carry thick foam (it showed as
// white paint with holes on the terrain).
float foamOf(HfSpan t) {
    return t.flux == HF_NONE ? 0.0 : foam[HF_FOAM_READ + hfFoamIndex(t)] * smoothstep(0.02, 0.15, depth[t.span]);
}

// Water below HF_FILM_DRY is never drawn; between that and HF_RENDER_DRY it is drawn while it runs (hf_common.glsl: outflow
// above HF_FILM_DRAW, as low as the thinnest sheet drawn over an edge, held for HF_FILM_SWITCH before it switches).
const float FLOW_DRY = HF_FILM_DRY;

// Whether span t has water worth drawing. Still films under HF_RENDER_DRY stay hidden (they shimmered on flat ground), but a
// thin layer that is moving (running down steps or a slope) is drawn: hiding it punched holes cell by cell into shallow
// streams, which then looked like scattered pieces instead of a flow.
// How much of span t's water is in the drawn surface, 0..1: the coverage marching squares interpolates (hf_depth.comp keeps it,
// see hfPresenceTarget). Corners blend each span between its dry and its wet height by this, so the waterline moves through
// the cells continuously as water arrives or leaves instead of jumping half a block when a span turns wet. On a tile that is
// not simulated (asleep, or loaded and never woken) nothing updates it, so there the target is taken as it stands.
// How deep under the ground a shoreline corner with no water goes (shoreQuad and corner()).
const float SHORE_BELOW = 0.25;
float presence(uint t) {
    uint ps = hfPageSpans();
    int owner = pageOwner[t / ps];
    bool simulated = owner >= 0 && tileInfo[uint(owner >> 2) * 4u + 3u][owner & 3] >= 0;
    float v = air[t * HF_AIR_STRIDE + 3u];
    return simulated ? hfShown(v) : hfPresenceTarget(depth[t], hfRunning(v), 0.0, hfLakeEdge(v));
}

bool wet(uint t) {
    return presence(t) > 0.0;
}

float surfaceOf(uint t) {
    vec2 g = hfGeo(t);
    return min(g.x + depth[t], g.y);
}

// The surface as drawn: at least HF_FILM_MIN_DRAWN over the floor (a few mm of running water on the ground z-fights with it).
float drawnSurfaceOf(uint t) {
    vec2 g = hfGeo(t);
    return min(g.x + max(depth[t], HF_FILM_MIN_DRAWN), g.y);
}

// Two wet spans form one water surface only when their water columns overlap in height. A link only says the open spaces
// overlap: ground water next to a puddle on a roof is linked too, and averaging the two would draw slanted sheets up the wall.
bool joined(uint a, uint t) {
    return wet(t) && hfGeo(t).x < surfaceOf(a) && hfGeo(a).x < surfaceOf(t);
}

// Spans whose surfaces differ by up to this much and that exchange water are drawn as one sloped surface (a ramp of
// flowing water over a step) instead of two separate pieces with a sheet between them; bigger drops get a falling sheet.
// Only water at least RAMP_MIN_DEPTH x the drop deep makes a ramp: a thin film over a step pours off it as a thin sheet down
// the face (a ramp between 2 cm films a block apart was a slanted glass wedge standing in the air over the edge).
const float RAMP_MAX_DROP = 1.6;
const float RAMP_MIN_FLOW = 0.02;
const float RAMP_MIN_DEPTH = 0.35;

float outflowTo(HfSpan a, int dir) {
    return a.flux == HF_NONE ? 0.0 : flux[a.flux + uint(dir * 2)] + flux[a.flux + uint(dir * 2 + 1)];
}

// Whether a and its neighbor t in direction dir are drawn as one surface: their water columns overlap (joined), or water flows
// between them over a small drop. Symmetric, so both sides compute the same shared corners and the surface has no cracks.
bool linked(HfSpan a, int dir, HfSpan t) {
    // Both must be wet: joined() alone only checks t, which made the relation one-sided next to dry spans.
    if (!wet(a.span) || !wet(t.span)) {
        return false;
    }
    if (joined(a.span, t.span)) {
        return true;
    }
    float drop = abs(surfaceOf(a.span) - surfaceOf(t.span));
    if (drop > RAMP_MAX_DROP || max(depth[a.span], depth[t.span]) < RAMP_MIN_DEPTH * drop) {
        return false;
    }
    return outflowTo(a, dir) + outflowTo(t, dir ^ 1) > RAMP_MIN_FLOW;
}

// Neighbor span in a direction, preferring one drawn as the same surface as ours. Slot j = 0 holds the largest opening.
bool pick(HfSpan a, int dir, out HfSpan r) {
    bool found = false;
    for (int j = 0; j < 2; j++) {
        uint k = uint(dir * 2 + j);
        uint nib = hfLink(a, k);
        HfSpan t;
        // Sleeping tiles still show their water, so neighbors resolve by existence, not by activity.
        if (nib == HF_LINK_NONE || !hfNeighbor(a, k, nib, false, t)) {
            continue;
        }
        if (linked(a, dir, t)) {
            r = t;
            return true;
        }
        if (!found) {
            r = t;
            found = true;
        }
    }
    return found;
}

// What a neighbor at one of our corners adds: a linked span its surface, dry ground a shoreline height (toward its floor, but
// within the corner's water; over a drop most of the water depth stays up to the brink, where it pours off). Walls and water
// at a separate level add nothing (NaN). Everything is relative to the corner's water, not to our own span, so every span
// sharing the corner gets the same height and the surface has no cracks.
// Neighbor t at a corner is dry ground at the corner's floor (flat shoreline), or dry at another height.
bool dryFlat(bool ok, bool link, HfSpan t, float lo) {
    return ok && !link && !wet(t.span) && abs(hfGeo(t.span).x - lo) <= 0.05;
}

bool dryOther(bool ok, bool link, HfSpan t, float lo) {
    return ok && !link && !wet(t.span) && abs(hfGeo(t.span).x - lo) > 0.05;
}

// The height a sharer of a corner gives it when dry: its floor (within the corner's water), or most of the water's depth over a
// drop (the water stays up to the brink and pours off there).
float drySample(float nf, float lo, float level) {
    return nf < lo - 0.05 ? mix(lo, level, 0.7) : clamp(nf, lo, level);
}

// What a neighbor at one of our corners adds: a linked span its surface blended toward its dry height by how present its water
// is, dry ground its dry height. Walls and water at a separate level add nothing (NaN). Everything is relative to the corner's
// water, not to our own span, so every span sharing the corner gets the same height and the surface has no cracks.
float cornerSample(bool ok, bool link, HfSpan t, float lo, float level) {
    if (!ok) {
        return uintBitsToFloat(0x7FC00000u);
    }
    float nf = hfGeo(t.span).x;
    if (link) {
        return mix(drySample(nf, lo, level), drawnSurfaceOf(t.span), presence(t.span));
    }
    // Water at a separate level adds nothing; nor does dry ground at another height (a bank to meet, an edge to pour over): the
    // corner is the water's and the shoreline's on our floor only, so a front reaching a bank or a brink moves as smoothly as on
    // open ground (those corners had a rule of their own, which switched over as the water arrived).
    if (wet(t.span) || abs(nf - lo) > 0.05) {
        return uintBitsToFloat(0x7FC00000u);
    }
    return lo;
}

// A sharer that is (partly) dry ground at the corner's floor: dry, or linked water only partly there.
bool flatLike(bool ok, bool link, HfSpan t, float lo) {
    return ok && (link ? presence(t.span) < 1.0 : !wet(t.span)) && abs(hfGeo(t.span).x - lo) <= 0.05;
}

// Height, smooth normal and foam at one corner, from the (up to) four spans sharing it: the average over our span, the spans
// linked to it and shoreline samples from dry neighbors, each linked span weighted by how present its water is. A ramp corner
// may lie below our own floor (down to the lowest linked floor); the vanilla-like surface drop uses the corner's water depth.
// Horizontal water velocity of a span from its outflows (blocks/s, capped at 8); zero on tiles that are not simulated.
vec2 velocityOf(HfSpan t) {
    if (t.flux == HF_NONE) {
        return vec2(0.0);
    }
    vec2 v = vec2(outflowTo(t, 0) - outflowTo(t, 1), outflowTo(t, 2) - outflowTo(t, 3)) / (HF_CELL * max(depth[t.span], 0.05));
    float sp = length(v);
    return sp > 8.0 ? v * (8.0 / sp) : v;
}

vec4 corner(HfSpan a, int sx, int sz, float fl, float top, float ce, out vec2 flow) {
    int dirX = sx > 0 ? 0 : 1;
    int dirZ = sz > 0 ? 2 : 3;
    HfSpan nx;
    HfSpan nz;
    HfSpan nd;
    bool okX = pick(a, dirX, nx);
    bool okZ = pick(a, dirZ, nz);
    bool eSX = okX && linked(a, dirX, nx);
    bool eSZ = okZ && linked(a, dirZ, nz);
    // The diagonal span, reached through either side. The corner's water is the part of the four-span loop S-X-D-Z connected to
    // us, so every span sharing the corner finds the same set (a one-sided "via x only" rule left cracks on uneven slopes).
    HfSpan dx;
    HfSpan dz;
    bool okDX = okX && pick(nx, dirZ, dx);
    bool okDZ = okZ && pick(nz, dirX, dz);
    bool eXD = okDX && linked(nx, dirZ, dx);
    bool eZD = okDZ && linked(nz, dirX, dz);
    bool okD = okDX || okDZ;
    bool same = okDX && okDZ && dx.span == dz.span;
    if (okDX && (eXD || !(okDZ && eZD))) {
        nd = dx;
        eZD = same && eZD;
    } else if (okDZ) {
        nd = dz;
        eXD = same && eXD;
    }
    bool lx = eSX || (eSZ && eZD && eXD);
    bool lz = eSZ || (eSX && eXD && eZD);
    bool ld = (eSX && eXD) || (eSZ && eZD);
    // The corner's water: our span and the spans linked to it, each weighted by how present its water is.
    float pa = presence(a.span);
    float px = lx ? presence(nx.span) : 0.0;
    float pz = lz ? presence(nz.span) : 0.0;
    float pd = ld ? presence(nd.span) : 0.0;
    top = max(top, min(fl + HF_FILM_MIN_DRAWN, ce));
    float weight = pa + px + pz + pd;
    float levelSum = pa * top;
    float lo = fl;
    float hiC = ce;
    float depthSum = pa * (top - fl);
    // The shallowest water at the corner (each sharer by its presence) limits the vanilla-like surface drop: over a block top a
    // few cm under a lake the full drop put the drawn surface under the block, which stood out dry.
    float shallow = mix(2.0, top - fl, pa);
    float aer = pa * foamOf(a);
    flow = pa * velocityOf(a);
    if (lx) {
        flow += px * velocityOf(nx);
        vec2 gx = hfGeo(nx.span);
        levelSum += px * drawnSurfaceOf(nx.span);
        lo = min(lo, gx.x);
        hiC = min(hiC, gx.y);
        depthSum += px * (drawnSurfaceOf(nx.span) - gx.x);
        shallow = min(shallow, mix(2.0, drawnSurfaceOf(nx.span) - gx.x, px));
        aer += px * foamOf(nx);
    }
    if (lz) {
        flow += pz * velocityOf(nz);
        vec2 gz = hfGeo(nz.span);
        levelSum += pz * drawnSurfaceOf(nz.span);
        lo = min(lo, gz.x);
        hiC = min(hiC, gz.y);
        depthSum += pz * (drawnSurfaceOf(nz.span) - gz.x);
        shallow = min(shallow, mix(2.0, drawnSurfaceOf(nz.span) - gz.x, pz));
        aer += pz * foamOf(nz);
    }
    if (ld) {
        flow += pd * velocityOf(nd);
        vec2 gd = hfGeo(nd.span);
        levelSum += pd * drawnSurfaceOf(nd.span);
        lo = min(lo, gd.x);
        hiC = min(hiC, gd.y);
        depthSum += pd * (drawnSurfaceOf(nd.span) - gd.x);
        shallow = min(shallow, mix(2.0, drawnSurfaceOf(nd.span) - gd.x, pd));
        aer += pd * foamOf(nd);
    }
    weight = max(weight, 1.0e-6);
    float level = levelSum / weight;
    float hs = mix(drySample(fl, lo, level), top, pa);
    float hx = cornerSample(okX, lx, nx, lo, level);
    float hz = cornerSample(okZ, lz, nz, lo, level);
    float hd = cornerSample(okD, ld, nd, lo, level);
    // Ground at the corner's floor that is (partly) dry (a shoreline on flat ground), and any other dry neighbor (a bank above, a
    // drop below).
    bool flatShore = (pa < 1.0 && abs(fl - lo) <= 0.05) || flatLike(okX, lx, nx, lo) || flatLike(okZ, lz, nz, lo) || flatLike(okD, ld, nd, lo);
    bool otherDry = false;
    float sum = hs;
    float count = 1.0;
    // The wet share of the corner: the sharers' presence (dry ground 0).
    float cover = pa;
    if (!isnan(hx)) {
        sum += hx;
        count += 1.0;
        cover += px;
    }
    if (!isnan(hz)) {
        sum += hz;
        count += 1.0;
        cover += pz;
    }
    if (!isnan(hd)) {
        sum += hd;
        count += 1.0;
        cover += pd;
    }
    float h = sum / count;
    // Missing samples take the corner height, so the slope comes only from what is there (and matches on every side).
    hx = isnan(hx) ? h : hx;
    hz = isnan(hz) ? h : hz;
    hd = isnan(hd) ? h : hd;
    float c = HF_CELL;
    float dhdx = ((hx - hs) + (hd - hz)) * 0.5 / c * float(sx);
    float dhdz = ((hz - hs) + (hd - hx)) * 0.5 / c * float(sz);
    if (flatShore && !otherDry && level - lo > 1.0e-4) {
        // Shoreline on flat ground, as in marching squares: by the share of the corner that is wet, w (the sharers' mean
        // presence), the corner goes from below the ground (1 of 4 cells wet) through the ground (2 of 4) up to the water level
        // (all 4). The surface then meets the ground on a line cutting through the cells, not along their half-block edges, and
        // dips under the ground past it (shoreQuad continues it into the dry cells). Partly present water counts in part, so the
        // line moves through a cell as its water arrives (by presence, not by height: a 1 cm film's height says nothing).
        // Under the ground it goes down to SHORE_BELOW, the depth shoreQuad gives corners no water touches, whatever the water's
        // depth: on a 1 cm film that dip was only 1 cm, so the line sat almost anywhere along the half-block edge.
        float w = clamp(cover / count, 0.0, 1.0);
        h = min(lo + (w >= 0.5 ? level - lo : SHORE_BELOW) * (2.0 * w - 1.0), hiC);
    } else {
        h = clamp(h, lo, hiC);
    }
    h -= HF_SURFACE_DROP * clamp(min(min(depthSum / weight, shallow), h - lo), 0.0, 1.0);
    vec3 n = normalize(vec3(-dhdx, 1.0, -dhdz));
    flow /= weight;
    return vec4(n.x, h, n.z, aer / weight);
}

vec3 cornerNormal(vec4 c) {
    return normalize(vec3(c.x, sqrt(max(1.0 - c.x * c.x - c.z * c.z, 1e-4)), c.z));
}

void emitTop(uint q, vec3 a, vec3 b, vec3 c, vec3 d, vec4 ca, vec4 cb, vec4 cc, vec4 cd, vec2 fa, vec2 fb, vec2 fc, vec2 fd) {
    if (q >= HF_QUAD_CAP) {
        return;
    }
    uint v = q * 4u;
    verts[v] = vec4(a, uintBitsToFloat(hfPack(cornerNormal(ca), false, ca.w)));
    verts[v + 1u] = vec4(b, uintBitsToFloat(hfPack(cornerNormal(cb), false, cb.w)));
    verts[v + 2u] = vec4(c, uintBitsToFloat(hfPack(cornerNormal(cc), false, cc.w)));
    verts[v + 3u] = vec4(d, uintBitsToFloat(hfPack(cornerNormal(cd), false, cd.w)));
    vertFlow[v] = packHalf2x16(fa);
    vertFlow[v + 1u] = packHalf2x16(fb);
    vertFlow[v + 2u] = packHalf2x16(fc);
    vertFlow[v + 3u] = packHalf2x16(fd);
    quads[q] = uvec4(v, v + 1u, v + 2u, v + 3u);
}

void emit(uint q, vec3 a, vec3 b, vec3 c, vec3 d, vec3 normal, bool wall) {
    if (q >= HF_QUAD_CAP) {
        return;
    }
    float packed = uintBitsToFloat(hfPack(normal, wall, 0.0));
    uint v = q * 4u;
    verts[v] = vec4(a, packed);
    verts[v + 1u] = vec4(b, packed);
    verts[v + 2u] = vec4(c, packed);
    verts[v + 3u] = vec4(d, packed);
    for (uint j = 0u; j < 4u; j++) {
        vertFlow[v + j] = 0u;
    }
    quads[q] = uvec4(v, v + 1u, v + 2u, v + 3u);
}

// Whether span t pours over its edge in direction d as a falling sheet: the water it flows into lies below its floor and the
// outflow is above HF_CURTAIN_MIN. land: where it lands (world y); v0: the speed it leaves the edge at; q: the outflow
// (blocks^3/s).
// down: the falling water has reached where it lands (water over a drop is in the air for its fall time, hf_depth.comp); until
// then the sheet ends at the falling front, in mid-air.
bool curtainOf(HfSpan t, int d, out float land, out float v0, out float q, out bool down) {
    land = 0.0;
    v0 = 0.0;
    q = 0.0;
    down = true;
    HfSpan n;
    if (t.flux == HF_NONE || !pick(t, d, n) || linked(t, d, n)) {
        return false;
    }
    float fl = hfGeo(t.span).x;
    land = wet(n.span) ? surfaceOf(n.span) : hfGeo(n.span).x;
    float inAir = air[n.span * HF_AIR_STRIDE];
    float fallen = air[n.span * HF_AIR_STRIDE + 1u];
    if (inAir > 0.0 && fallen < hfFallTime(air[n.span * HF_AIR_STRIDE + 2u])) {
        down = false;
        land = max(land, fl - hfFallDistance(fallen));
    }
    q = outflowTo(t, d);
    if (land >= fl - 0.05 || q <= HF_CURTAIN_MIN) {
        return false;
    }
    // A sheet grows down from the edge as the water there comes in (its presence), instead of hanging down in full at once.
    float p = presence(t.span);
    if (p < 1.0) {
        land = mix(fl - 0.05, land, p);
        down = down && p >= 1.0;
    }
    v0 = clamp(q / (HF_CELL * max(surfaceOf(t.span) - fl, 0.03)), 0.2, 4.0);
    return true;
}

// One end of a sheet, at the corner shared with the neighbor across side direction sd: (landing height, speed off the edge,
// floor at the edge, 1 when shared). When that neighbor's water joins ours and pours over the same edge, both sheets use the
// averages there (symmetric, so both compute the very same vertices) and meet as one curtain; otherwise the end is free.
vec4 curtainEnd(HfSpan a, int d, int sd, float land, float v0) {
    HfSpan n;
    float nl;
    float nv;
    float nq;
    float fl = hfGeo(a.span).x;
    bool nd;
    if (pick(a, sd, n) && linked(a, sd, n) && curtainOf(n, d, nl, nv, nq, nd)) {
        return vec4(0.5 * (land + nl), 0.5 * (v0 + nv), 0.5 * (fl + hfGeo(n.span).x), 1.0);
    }
    return vec4(land, v0, fl, 0.0);
}

struct SheetPoint {
    vec3 top;     // the sheet's outer surface (continues the water surface over the edge)
    vec3 bottom;  // its inner surface (continues the floor), facing the cliff
    vec3 n;       // outer normal
    float speed;
    float drop;   // how far it has fallen from the edge
};

// Where water leaving the edge point e (xz on the edge, y = the water surface there) is after a fraction s of its fall. It
// leaves horizontally at the speed v0 and falls freely, so the lip curls over with the radius real water has (about v0^2 / g)
// instead of a hard corner; its outward travel eases off toward CURTAIN_REACH. The inner surface takes the same path from the
// floor at the edge and lands at the same place, so it starts the water's depth below the outer one and closes in on it as
// both steepen: the sheet thins as it falls (offsetting along the turning normal instead folded deep, slow pours).
SheetPoint sheetPoint(vec3 e, vec2 outward, vec4 end, float s, vec2 inward, bool free) {
    SheetPoint r;
    float v0 = end.y;
    vec3 dir = vec3(outward.x, 0.0, outward.y);
    float h = max(e.y - end.x, 0.0);
    float t = sqrt(2.0 * h / GRAVITY) * s;
    float k = exp(-v0 * t / CURTAIN_REACH);
    float vx = v0 * k;
    float vy = GRAVITY * t;
    r.drop = h * s * s;
    r.speed = sqrt(vx * vx + vy * vy);
    r.n = normalize(dir * vy + vec3(0.0, vx, 0.0));
    r.top = vec3(e.x, e.y - r.drop, e.z) + dir * (CURTAIN_REACH * (1.0 - k));
    float floorY = min(end.z, e.y);
    float hl = max(floorY - end.x, 0.0);
    float tl = sqrt(2.0 * hl / GRAVITY) * s;
    r.bottom = vec3(e.x, floorY - hl * s * s, e.z) + dir * (CURTAIN_REACH * (1.0 - exp(-v0 * tl / CURTAIN_REACH)));
    // At least a thin film thick, never into the cliff under the edge or below where it lands.
    r.bottom -= r.n * max(0.012 - dot(r.top - r.bottom, r.n), 0.0);
    float outTop = dot(r.top.xz - e.xz, outward);
    r.bottom.xz += outward * max(min(0.004, outTop) - dot(r.bottom.xz - e.xz, outward), 0.0);
    r.bottom.y = max(r.bottom.y, end.x);
    if (free) {
        // A free end narrows as it falls: the water at a sheet's side is pulled in and breaks up first.
        vec2 c = inward * (0.1 * (1.0 - exp(-r.drop / 0.6)));
        r.top.xz += c;
        r.bottom.xz += c;
    }
    return r;
}

// Foam of a falling sheet: the top surface's foam where it leaves the edge, whitening as it falls (thin trickles less), and
// more at a free end. Uses only values both sheets at a shared end agree on, so the curtain has no seams.
// A trickle (outflow per width under ~0.02 blocks^2/s) stays clear: a film running down a block face is not white.
float sheetAer(float aerTop, SheetPoint p, vec3 e, vec4 end, bool free) {
    float unit = end.y * max(e.y - end.z, 0.0);
    float body = 0.35 * smoothstep(0.0, 0.02, unit) + 0.65 * smoothstep(0.02, 0.4, unit);
    float w = 1.0 - exp(-p.drop / 2.5);
    return clamp(mix(aerTop, 0.65 * body, w) + (free ? 0.2 * w : 0.0), 0.0, 1.0);
}

// A sheet vertex. Its flow word carries what composite.frag needs to texture it continuously from the top surface: the
// sheet's direction (d) and speed packed as 16 (d + 1) + speed, and how far it has fallen (see mesh_front.frag).
void sheetVertex(uint v, vec3 p, vec3 n, float aer, int d, SheetPoint s) {
    verts[v] = vec4(p, uintBitsToFloat(hfPack(n, true, aer)));
    vertFlow[v] = packHalf2x16(vec2(16.0 * float(d + 1) + clamp(s.speed, 0.0, 8.0), s.drop));
}

// Quads a sheet takes: an outer and an inner surface per segment, plus a cap per segment at each free end.
uint curtainQuads(vec4 end0, vec4 end1) {
    return uint(CURTAIN_SEGMENTS) * (2u + (end0.w < 0.5 ? 1u : 0u) + (end1.w < 0.5 ? 1u : 0u));
}

// A falling sheet from the edge e0..e1, poured over in direction d (outward), drawn as a closed thin ribbon: the outer surface
// continues the top surface (same corner heights, normals and foam on its first row), the inner one continues the floor, and
// caps close its free ends. Closed, the thickness pass measures the sheet itself, not the air between it and the cliff (a
// single open face was closed by the terrain behind, which made the sheet a tinted slab). c0, c1: the top surface's corners.
void emitCurtain(uint q, int d, vec2 outward, vec3 e0, vec3 e1, vec4 end0, vec4 end1, vec4 c0, vec4 c1) {
    vec2 in0 = normalize(e1.xz - e0.xz);
    bool free0 = end0.w < 0.5;
    bool free1 = end1.w < 0.5;
    vec3 cap0 = vec3(-in0.x, 0.0, -in0.y);
    vec3 cap1 = -cap0;
    SheetPoint a0 = sheetPoint(e0, outward, end0, 0.0, in0, free0);
    SheetPoint a1 = sheetPoint(e1, outward, end1, 0.0, -in0, free1);
    float aa0 = sheetAer(c0.w, a0, e0, end0, free0);
    float aa1 = sheetAer(c1.w, a1, e1, end1, free1);
    // Where the sheet leaves the edge it takes the top surface's normals, so the shading flows over the lip.
    vec3 na0 = cornerNormal(c0);
    vec3 na1 = cornerNormal(c1);
    for (int i = 0; i < CURTAIN_SEGMENTS; i++) {
        float s = CURTAIN_T[i + 1];
        SheetPoint b0 = sheetPoint(e0, outward, end0, s, in0, free0);
        SheetPoint b1 = sheetPoint(e1, outward, end1, s, -in0, free1);
        float ab0 = sheetAer(c0.w, b0, e0, end0, free0);
        float ab1 = sheetAer(c1.w, b1, e1, end1, free1);
        for (int face = 0; face < 4; face++) {
            if ((face == 2 && !free0) || (face == 3 && !free1)) {
                continue;
            }
            if (q >= HF_QUAD_CAP) {
                return;
            }
            uint v = q * 4u;
            if (face == 0) {
                // Outer surface; vertex order lower e0, lower e1, upper e1, upper e0 like the side walls.
                sheetVertex(v, b0.top, b0.n, ab0, d, b0);
                sheetVertex(v + 1u, b1.top, b1.n, ab1, d, b1);
                sheetVertex(v + 2u, a1.top, na1, aa1, d, a1);
                sheetVertex(v + 3u, a0.top, na0, aa0, d, a0);
            } else if (face == 1) {
                sheetVertex(v, b0.bottom, -b0.n, ab0, d, b0);
                sheetVertex(v + 1u, b1.bottom, -b1.n, ab1, d, b1);
                sheetVertex(v + 2u, a1.bottom, -a1.n, aa1, d, a1);
                sheetVertex(v + 3u, a0.bottom, -a0.n, aa0, d, a0);
            } else {
                bool first = face == 2;
                SheetPoint lo = first ? b0 : b1;
                SheetPoint hi = first ? a0 : a1;
                vec3 cn = first ? cap0 : cap1;
                float al = first ? ab0 : ab1;
                float ah = first ? aa0 : aa1;
                sheetVertex(v, lo.bottom, cn, al, d, lo);
                sheetVertex(v + 1u, lo.top, cn, al, d, lo);
                sheetVertex(v + 2u, hi.top, cn, ah, d, hi);
                sheetVertex(v + 3u, hi.bottom, cn, ah, d, hi);
            }
            quads[q] = uvec4(v, v + 1u, v + 2u, v + 3u);
            q++;
        }
        a0 = b0;
        a1 = b1;
        aa0 = ab0;
        aa1 = ab1;
        na0 = b0.n;
        na1 = b1.n;
    }
}

// Spray particles per second per unit of energy a sheet brings down (outflow in blocks^3/s x drop in blocks).
const float SPRAY_SPLASH_RATE = 170.0;
const float SPRAY_SHEET_RATE = 60.0;
// Mist is off until it looks like more than bright puffs (the type and its rendering stay).
const float SPRAY_MIST_RATE = 0.0;
const float SPRAY_DROP_RATE = 12.0;

// Spray thrown by a falling sheet: droplets bouncing back up and out where it lands (faster for taller falls), droplets peeling
// off it as it falls, and mist at its foot. The rates grow with the energy the water brings down (outflow x drop), so trickles
// and small steps barely spray while a tall fall throws a cloud. Positions as the mesh's (relative to the origin).
void emitSpray(uint seed, vec2 outward, vec3 e0, vec3 e1, vec4 end0, vec4 end1, float q, bool down) {
    float dt = HF_SPRAY_DT;
    if (dt <= 0.0) {
        return;
    }
    // Until the falling water lands there is no foot to splash from; only the sheet itself sheds spray.
    float drop = max(0.5 * (e0.y + e1.y) - 0.5 * (end0.x + end1.x), 0.0);
    float energy = q * min(drop, 16.0) * smoothstep(0.3, 1.5, drop);
    if (energy <= 1.0e-4) {
        return;
    }
    uint s = sprayHash(seed);
    vec3 dir = vec3(outward.x, 0.0, outward.y);
    vec3 side = vec3(-outward.y, 0.0, outward.x);
    vec3 up = vec3(0.0, 1.0, 0.0);
    // Speed at the foot with air drag (hf_common.glsl): a high fall hits at most about HF_AIR_TERMINAL.
    float impact = HF_AIR_TERMINAL * tanh(HF_AIR_G * hfFallTime(drop) / HF_AIR_TERMINAL);
    int splash = down ? int(min(SPRAY_SPLASH_RATE * energy * dt + sprayRand(s), 24.0)) : 0;
    for (int k = 0; k < splash; k++) {
        float t = sprayRand(s);
        SheetPoint p = sheetPoint(mix(e0, e1, t), outward, mix(end0, end1, t), 1.0, vec2(0.0), false);
        float az = (sprayRand(s) - 0.5) * 2.6;
        float el = mix(0.45, 1.35, sprayRand(s));
        vec3 h = dir * cos(az) + side * sin(az);
        vec3 v = (h * cos(el) + up * sin(el)) * impact * mix(0.1, 0.4, sprayRand(s));
        sprayAdd(HF_SPRAY_INTO, p.top + up * 0.04, v, mix(0.6, 1.5, sprayRand(s)), SPRAY_DROPLET);
    }
    // A few bigger water drops (drawn as water) bounce out of the foot too.
    int drops = down ? int(min(SPRAY_DROP_RATE * energy * dt + sprayRand(s), 4.0)) : 0;
    for (int k = 0; k < drops; k++) {
        float t = sprayRand(s);
        SheetPoint p = sheetPoint(mix(e0, e1, t), outward, mix(end0, end1, t), 1.0, vec2(0.0), false);
        float az = (sprayRand(s) - 0.5) * 2.2;
        float el = mix(0.6, 1.3, sprayRand(s));
        vec3 h = dir * cos(az) + side * sin(az);
        vec3 v = (h * cos(el) + up * sin(el)) * min(impact * mix(0.12, 0.3, sprayRand(s)), 6.0);
        dropAdd(HF_SPRAY_INTO, p.top + up * 0.06, v, 3.0, mix(0.5, 1.1, sprayRand(s)));
    }
    int mist = down ? int(min(SPRAY_MIST_RATE * energy * dt + sprayRand(s), 6.0)) : 0;
    for (int k = 0; k < mist; k++) {
        float t = sprayRand(s);
        SheetPoint p = sheetPoint(mix(e0, e1, t), outward, mix(end0, end1, t), 1.0, vec2(0.0), false);
        vec3 v = (dir * mix(0.3, 1.0, sprayRand(s)) + side * (sprayRand(s) - 0.5) + up * mix(0.3, 1.0, sprayRand(s)))
            * min(0.15 * impact, 2.0);
        sprayAdd(HF_SPRAY_INTO, p.top + up * 0.15, v, mix(1.5, 3.0, sprayRand(s)), SPRAY_MIST);
    }
    int sheet = int(min(SPRAY_SHEET_RATE * energy * dt + sprayRand(s), 12.0));
    for (int k = 0; k < sheet; k++) {
        float t = sprayRand(s);
        float f = mix(0.3, 0.95, sprayRand(s));
        vec3 e = mix(e0, e1, t);
        vec4 end = mix(end0, end1, t);
        SheetPoint p = sheetPoint(e, outward, end, f, vec2(0.0), false);
        // The sheet's own velocity there (falling with air drag, as the water does), plus a push away from it.
        float fall = hfFallTime(max(e.y - end.x, 0.0) * f * f);
        float vx = end.y * exp(-end.y * fall / CURTAIN_REACH);
        float vy = HF_AIR_TERMINAL * tanh(HF_AIR_G * fall / HF_AIR_TERMINAL);
        vec3 v = dir * (vx + mix(0.3, 1.2, sprayRand(s))) + side * (sprayRand(s) - 0.5) * 0.8 - up * vy;
        sprayAdd(HF_SPRAY_INTO, p.top + dir * 0.02, v, mix(0.8, 1.6, sprayRand(s)), SPRAY_DROPLET);
    }
}

// How far below the ground a shore surface reaches at a corner no wet cell touches.

// Wet span on the same floor as fl (water on flat ground next to it).
bool wetAt(bool ok, HfSpan t, float fl) {
    return ok && wet(t.span) && abs(hfGeo(t.span).x - fl) <= 0.05;
}

// A dry span next to water on flat ground: a surface continuing the wet neighbors' corners into it (each corner taken from a wet
// cell sharing it, with exactly that cell's own corner() call, so the two meet without a crack) and dipping under the ground
// where no wet cell touches. The waterline is where it crosses the ground (see the marching-squares remap in corner()).
void shoreQuad(HfSpan a, vec2 g, ivec2 cell) {
    float fl = g.x;
    HfSpan nb[4];
    bool has[4];
    bool near = false;
    for (int d = 0; d < 4; d++) {
        has[d] = pick(a, d, nb[d]);
        near = near || wetAt(has[d], nb[d], fl);
    }
    if (!near) {
        return;
    }
    const ivec2 SIGN[4] = ivec2[](ivec2(-1, -1), ivec2(1, -1), ivec2(1, 1), ivec2(-1, 1));
    vec4 c[4];
    vec2 f[4];
    bool seen = false;
    for (int i = 0; i < 4; i++) {
        int sx = SIGN[i].x;
        int sz = SIGN[i].y;
        int dirX = sx > 0 ? 0 : 1;
        int dirZ = sz > 0 ? 2 : 3;
        HfSpan w;
        int wx = 0;
        int wz = 0;
        bool found = false;
        if (wetAt(has[dirX], nb[dirX], fl)) {
            w = nb[dirX];
            wx = -sx;
            wz = sz;
            found = true;
        } else if (wetAt(has[dirZ], nb[dirZ], fl)) {
            w = nb[dirZ];
            wx = sx;
            wz = -sz;
            found = true;
        } else {
            HfSpan dg;
            if ((has[dirX] && pick(nb[dirX], dirZ, dg) || has[dirZ] && pick(nb[dirZ], dirX, dg)) && wetAt(true, dg, fl)) {
                w = dg;
                wx = -sx;
                wz = -sz;
                found = true;
            }
        }
        if (found) {
            vec2 gw = hfGeo(w.span);
            c[i] = corner(w, wx, wz, gw.x, surfaceOf(w.span), gw.y, f[i]);
            seen = seen || c[i].y > fl;
        } else {
            c[i] = vec4(0.0, fl - SHORE_BELOW, 0.0, 0.0);
            f[i] = vec2(0.0);
        }
    }
    // All of it under the ground: nothing to draw.
    if (!seen) {
        return;
    }
    uint total = subgroupAdd(1u);
    uint within = subgroupExclusiveAdd(1u);
    uint base = 0u;
    if (subgroupElect()) {
        base = atomicAdd(meshCounters[1], total);
    }
    uint q = subgroupBroadcastFirst(base) + within;
    if (q >= HF_QUAD_CAP) {
        return;
    }
    float cs = HF_CELL;
    float x0 = float(cell.x) * cs;
    float x1 = x0 + cs;
    float z0 = float(cell.y) * cs;
    float z1 = z0 + cs;
    float oy = HF_ORIGIN_Y;
    emitTop(q, vec3(x0, c[0].y - oy, z0), vec3(x1, c[1].y - oy, z0), vec3(x1, c[2].y - oy, z1), vec3(x0, c[3].y - oy, z1),
        c[0], c[1], c[2], c[3], f[0], f[1], f[2], f[3]);
}

void main() {
    HfSpan a;
    if (!hfFromPage(GID_U, a)) {
        return;
    }
    // Tiles over chunks vanilla does not draw (beyond the render distance, not loaded) are not drawn either (HfDomain.setView).
    if (tileInfo[a.tile * 4u + 1u].w != 0) {
        return;
    }
    uint s = a.span;
    vec2 g = hfGeo(s);
    if (!hfValid(g)) {
        return;
    }
    ivec2 tile = tileInfo[a.tile * 4u + 1u].xy;
    ivec2 local = hfColumn(a.col);
    int cx = tile.x * HF_TN + local.x;
    int cz = tile.y * HF_TN + local.y;
    if (!wet(s)) {
        if (HF_DEBUG != 2) {
            shoreQuad(a, g, ivec2(cx, cz));
        }
        return;
    }
    float fl = g.x;
    float ce = g.y;
    float top = surfaceOf(s);
    float oy = HF_ORIGIN_Y;

    vec2 f00;
    vec2 f10;
    vec2 f11;
    vec2 f01;
    vec4 c00 = corner(a, -1, -1, fl, top, ce, f00);
    vec4 c10 = corner(a, 1, -1, fl, top, ce, f10);
    vec4 c11 = corner(a, 1, 1, fl, top, ce, f11);
    vec4 c01 = corner(a, -1, 1, fl, top, ce, f01);
    float h00 = c00.y - oy;
    float h10 = c10.y - oy;
    float h11 = c11.y - oy;
    float h01 = c01.y - oy;

    uint wallMask = 0u;
    uint curtainMask = 0u;
    float inset[4];
    float curtainLand[4];
    float curtainSpeed[4];
    float curtainFlow[4];
    bool curtainDown[4];
    for (int d = 0; d < 4; d++) {
        HfSpan t;
        bool ok = pick(a, d, t);
        inset[d] = ok ? 0.0 : WALL_INSET;
        // No side face toward dry ground at our floor: the surface runs on into the ground there (shoreQuad).
        bool flatDry = ok && !wet(t.span) && abs(hfGeo(t.span).x - fl) <= 0.05;
        if (!ok || !linked(a, d, t) && !flatDry) {
            wallMask |= 1u << d;
        }
        // Water pouring over an edge onto lower ground or into lower water: a falling sheet down to where it lands.
        if (curtainOf(a, d, curtainLand[d], curtainSpeed[d], curtainFlow[d], curtainDown[d])) {
            curtainMask |= 1u << d;
        }
    }
    // A sheet replaces the side wall at its edge: the water body goes on into it (its outer surface continues the top, its
    // inner one the floor), so there is no flat face of water behind it.
    wallMask &= ~curtainMask;
    if (HF_DEBUG == 1) {
        wallMask = 0u;
    }
    // Per edge: its two corners and the side direction each corner is shared across (see curtainEnd).
    const int SIDE0[4] = int[](3, 2, 0, 1);
    const int SIDE1[4] = int[](2, 3, 1, 0);
    vec4 end0s[4];
    vec4 end1s[4];
    uint curtainCount = 0u;
    for (int d = 0; d < 4; d++) {
        if ((curtainMask & (1u << d)) != 0u) {
            end0s[d] = curtainEnd(a, d, SIDE0[d], curtainLand[d], curtainSpeed[d]);
            end1s[d] = curtainEnd(a, d, SIDE1[d], curtainLand[d], curtainSpeed[d]);
            curtainCount += curtainQuads(end0s[d], end1s[d]);
        }
    }
    bool drawTop = HF_DEBUG != 2;
    uint count = (drawTop ? 1u : 0u) + uint(bitCount(wallMask)) + curtainCount;
    if (count == 0u) {
        return;
    }
    // One atomic per subgroup instead of one per span: every wet span reserving its quads on the same counter was the mesh pass's
    // bottleneck on big floods (hundreds of thousands of atomics on one address per frame). Offsets within the subgroup come
    // from a prefix sum over the spans still running here (as g2p.comp does for particles).
    uint total = subgroupAdd(count);
    uint within = subgroupExclusiveAdd(count);
    uint base = 0u;
    if (subgroupElect()) {
        base = atomicAdd(meshCounters[1], total);
    }
    uint q = subgroupBroadcastFirst(base) + within;
    if (q >= HF_QUAD_CAP) {
        return;
    }

    float c = HF_CELL;
    float x0 = float(cx) * c;
    float x1 = x0 + c;
    float z0 = float(cz) * c;
    float z1 = z0 + c;
    float b = fl - oy;

    if (drawTop) emitTop(q++, vec3(x0, h00, z0), vec3(x1, h10, z0), vec3(x1, h11, z1), vec3(x0, h01, z1), c00, c10, c11, c01,
        f00, f10, f11, f01);
    if ((wallMask & 1u) != 0u) {
        float x = x1 - inset[0];
        emit(q++, vec3(x, b, z0), vec3(x, b, z1), vec3(x, h11, z1), vec3(x, h10, z0), vec3(1.0, 0.0, 0.0), true);
    }
    if ((wallMask & 2u) != 0u) {
        float x = x0 + inset[1];
        emit(q++, vec3(x, b, z1), vec3(x, b, z0), vec3(x, h00, z0), vec3(x, h01, z1), vec3(-1.0, 0.0, 0.0), true);
    }
    if ((wallMask & 4u) != 0u) {
        float z = z1 - inset[2];
        emit(q++, vec3(x1, b, z), vec3(x0, b, z), vec3(x0, h01, z), vec3(x1, h11, z), vec3(0.0, 0.0, 1.0), true);
    }
    if ((wallMask & 8u) != 0u) {
        float z = z0 + inset[3];
        emit(q++, vec3(x0, b, z), vec3(x1, b, z), vec3(x1, h10, z), vec3(x0, h00, z), vec3(0.0, 0.0, -1.0), true);
    }
    vec3 e0s[4] = vec3[](vec3(x1, h10, z0), vec3(x0, h01, z1), vec3(x1, h11, z1), vec3(x0, h00, z0));
    vec3 e1s[4] = vec3[](vec3(x1, h11, z1), vec3(x0, h00, z0), vec3(x0, h01, z1), vec3(x1, h10, z0));
    vec4 c0s[4] = vec4[](c10, c01, c11, c00);
    vec4 c1s[4] = vec4[](c11, c00, c01, c10);
    const vec2 OUTWARD[4] = vec2[](vec2(1.0, 0.0), vec2(-1.0, 0.0), vec2(0.0, 1.0), vec2(0.0, -1.0));
    for (int d = 0; d < 4; d++) {
        if ((curtainMask & (1u << d)) == 0u) {
            continue;
        }
        // Heights relative to the mesh origin, like the corners.
        vec4 end0 = end0s[d] - vec4(oy, 0.0, oy, 0.0);
        vec4 end1 = end1s[d] - vec4(oy, 0.0, oy, 0.0);
        emitCurtain(q, d, OUTWARD[d], e0s[d], e1s[d], end0, end1, c0s[d], c1s[d]);
        q += curtainQuads(end0, end1);
        emitSpray(a.span * 4u + uint(d) + HF_SPRAY_SEED * 2654435761u, OUTWARD[d], e0s[d], e1s[d], end0, end1, curtainFlow[d],
            curtainDown[d]);
    }
}
