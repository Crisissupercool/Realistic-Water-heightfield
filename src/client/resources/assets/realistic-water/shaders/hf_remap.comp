#version 450
// After a tile's terrain changed (block placed or broken, chunk loaded), moves its water from the old span pages into the
// rebuilt ones, column by column. Water stays where it is: each new span takes the part of every old water body that lies in its
// own height range, so a block placed into a lake splits the column without lifting the water below it over the block (moving
// each body whole into one span did that, standing the water up as a column a block or two high). Water an old body held above
// its ceiling (under pressure) stays with the span it overlaps most; water inside cells that are solid now is gone, as when a
// placed block replaces a water block. Where a span's floor dropped (a block broken under water) the water keeps its depth, so the
// surface dips there and fills in from around.
// A tile that stays simulated keeps its flux pages (indexed by layer): each new layer takes the flow and foam of the old body
// that gave it the most water, so the water keeps moving through the edit instead of stopping and surging back.
// Water still in the air (hf_depth.comp) lands at once, in the new span holding its old span's floor (or overlapping it most).
#include "hf_common.glsl"
layout(local_size_x = 256) in;
layout(std430, binding = 2) buffer Depth { float depth[]; };
layout(std430, binding = 3) buffer Flux { float flux[]; };

#define HF_OLD_PAGES floatBitsToInt(hp.p0)
#define HF_NEW_PAGES floatBitsToInt(hp.p1)
#define HF_FLUX_PAGES hp.p2
#define HF_FOAM_HALF uint(HF_COUNT)

void main() {
    uint col = GID_U;
    if (col >= hfPageSpans()) {
        return;
    }
    ivec4 oldPages = HF_OLD_PAGES;
    ivec4 newPages = HF_NEW_PAGES;
    vec2 ng[4];
    float acc[4];
    int src[4];
    float srcAmount[4];
    float shown[4];
    for (int j = 0; j < 4; j++) {
        acc[j] = 0.0;
        src[j] = -1;
        srcAmount[j] = 0.0;
        ng[j] = newPages[j] >= 0 ? hfGeo(uint(newPages[j]) * hfPageSpans() + col) : vec2(1.0e30, -1.0e30);
    }
    for (int i = 0; i < 4; i++) {
        shown[i] = 0.0;
        if (oldPages[i] < 0) {
            continue;
        }
        uint s = uint(oldPages[i]) * hfPageSpans() + col;
        vec2 g = hfGeo(s);
        float d = depth[s];
        float inAir = air[s * HF_AIR_STRIDE];
        shown[i] = air[s * HF_AIR_STRIDE + 3u];
        if (hfValid(g) && inAir > 0.0) {
            int into = -1;
            float most = 0.0;
            for (int j = 0; j < 4; j++) {
                if (!hfValid(ng[j])) {
                    continue;
                }
                if (ng[j].x <= g.x + 0.01 && g.x + 0.01 < ng[j].y) {
                    into = j;
                    break;
                }
                float overlap = max(min(g.y, ng[j].y) - max(g.x, ng[j].x), 0.0);
                if (overlap > most) {
                    into = j;
                    most = overlap;
                }
            }
            if (into >= 0) {
                float cell = 1.0 / float(HF_CPB);
                acc[into] += inAir / (cell * cell);
            }
        }
        if (!hfValid(g) || d <= 0.0) {
            continue;
        }
        float lo = g.x;
        float hi = g.x + min(d, max(g.y - g.x, 0.0));
        float pressure = max(d - max(g.y - g.x, 0.0), 0.0);
        int best = -1;
        float bestOverlap = 0.0;
        for (int j = 0; j < 4; j++) {
            if (!hfValid(ng[j])) {
                continue;
            }
            float overlap = max(min(hi, ng[j].y) - max(lo, ng[j].x), 0.0);
            acc[j] += overlap;
            if (overlap > bestOverlap) {
                best = j;
                bestOverlap = overlap;
            }
            if (overlap > srcAmount[j]) {
                srcAmount[j] = overlap;
                src[j] = i;
            }
        }
        if (best >= 0) {
            acc[best] += pressure;
        }
    }
    // Flow and foam move with the water (read everything first: old and new layers share these pages).
    ivec4 fluxPages = HF_FLUX_PAGES;
    float f[4][8];
    float fo[4][2];
    for (int i = 0; i < 4; i++) {
        uint base = fluxPages[i] >= 0 ? uint(fluxPages[i]) * hfPageSpans() + col : 0u;
        for (uint k = 0u; k < HF_LINKS; k++) {
            f[i][k] = fluxPages[i] >= 0 ? flux[base * HF_LINKS + k] : 0.0;
        }
        fo[i][0] = fluxPages[i] >= 0 ? foam[base] : 0.0;
        fo[i][1] = fluxPages[i] >= 0 ? foam[HF_FOAM_HALF + base] : 0.0;
    }
    for (int j = 0; j < 4; j++) {
        if (fluxPages[j] < 0) {
            continue;
        }
        uint base = uint(fluxPages[j]) * hfPageSpans() + col;
        int from = src[j];
        for (uint k = 0u; k < HF_LINKS; k++) {
            flux[base * HF_LINKS + k] = from >= 0 ? f[from][k] : 0.0;
        }
        foam[base] = from >= 0 ? fo[from][0] : 0.0;
        foam[HF_FOAM_HALF + base] = from >= 0 ? fo[from][1] : 0.0;
    }
    for (int j = 0; j < 4; j++) {
        if (newPages[j] >= 0) {
            uint ns = uint(newPages[j]) * hfPageSpans() + col;
            depth[ns] = acc[j];
            air[ns * HF_AIR_STRIDE] = 0.0;
            air[ns * HF_AIR_STRIDE + 1u] = 0.0;
            air[ns * HF_AIR_STRIDE + 2u] = 0.0;
            // A film drawn as running stays drawn through the edit.
            air[ns * HF_AIR_STRIDE + 3u] = src[j] >= 0 ? shown[src[j]] : 0.0;
        }
    }
}
