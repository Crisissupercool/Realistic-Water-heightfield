#version 450
// Sets the shared "camera is underwater" flag when the camera is inside a wet heightfield span, and how far above the camera that
// water's surface is (z, with w = 1).
// The CPU finds the camera's tile and column and passes that tile's span pages, so this scans one column's layers.
#include "hf_common.glsl"
layout(local_size_x = 1) in;
layout(std430, binding = 2) readonly buffer Depth { float depth[]; };
layout(std430, binding = 12) buffer ViewState { uint viewBits[]; };

#define HF_CAMERA_Y hp.p0.x
#define HF_SURFACE_DROP hp.p0.y
#define HF_RENDER_DRY hp.p1.y
#define HF_PROBE_COL HF_COUNT
#define HF_PROBE_PAGES hp.p2

void main() {
    float camY = HF_CAMERA_Y;
    for (int l = 0; l < 4; l++) {
        int page = HF_PROBE_PAGES[l];
        if (page < 0) {
            continue;
        }
        uint s = uint(page) * hfPageSpans() + uint(HF_PROBE_COL);
        vec2 g = hfGeo(s);
        float h = depth[s];
        if (!hfValid(g) || h <= HF_RENDER_DRY) {
            continue;
        }
        // The drawn surface, not the simulated one: hf_mesh draws it HF_SURFACE_DROP lower (at most 3/4 of the depth). Against the
        // simulated level an eye up to 11 cm above the drawn surface counted as underwater, so the surface below it was shaded
        // from below and the view above it fogged: the line across the screen with water at eye height.
        float surface = min(g.x + h, g.y) - min(HF_SURFACE_DROP, 0.75 * h);
        if (camY > g.x && camY < surface) {
            atomicMax(viewBits[0], floatBitsToUint(1.0));
            atomicMax(viewBits[1], floatBitsToUint(1.0));
            // Where the water surface is above the camera (blocks), and that it is known (particle.vert hides spray above it).
            viewBits[2] = floatBitsToUint(surface - camY);
            viewBits[3] = floatBitsToUint(1.0);
            return;
        }
    }
}
