#version 450
// Sets the shared "camera is underwater" flag when the camera is inside a wet heightfield span.
#include "hf_common.glsl"
layout(local_size_x = 1) in;
layout(std430, binding = 1) readonly buffer Geo { vec2 geo[]; };
layout(std430, binding = 2) readonly buffer Depth { float depth[]; };
layout(std430, binding = 3) buffer ViewState { uint viewBits[]; };

#define HF_CAMERA hp.p0.xyz   // x, z relative to the domain origin; y in world blocks
#define HF_CELL hp.p0.w
#define HF_RENDER_DRY hp.p1.y

void main() {
    vec3 cam = HF_CAMERA;
    int cx = int(floor(cam.x / HF_CELL));
    int cz = int(floor(cam.z / HF_CELL));
    if (cx < 0 || cz < 0 || cx >= HF_NX || cz >= HF_NZ) {
        return;
    }
    uint column = uint(cz * HF_NX + cx);
    for (int l = 0; l < HF_LAYERS; l++) {
        uint s = column * uint(HF_LAYERS) + uint(l);
        vec2 g = geo[s];
        float h = depth[s];
        if (!hfValid(g) || h <= HF_RENDER_DRY) {
            continue;
        }
        if (cam.y > g.x && cam.y < min(g.x + h, g.y)) {
            atomicMax(viewBits[0], floatBitsToUint(1.0));
            atomicMax(viewBits[1], floatBitsToUint(1.0));
            return;
        }
    }
}
